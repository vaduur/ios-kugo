-		printf("KUGO PERF: MHz %llu/%llu/%llu/%llu/%llu/%llu  swaps %llu.%llu/s  presents %llu.%llu/s (%llu by the GPU)\n",
+		printf("KUGO PERF: MHz %llu/%llu/%llu/%llu/%llu/%llu  swaps %llu.%llu/s  presents %llu.%llu/s (%llu by the GPU)"
+		    "  boosted %llu%% (%llu switches)\n",
