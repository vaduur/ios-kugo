diff --git a/iokit/Kernel/arm/SweetCPU.cpp b/iokit/Kernel/arm/SweetCPU.cpp
index f23e721..665611d 100644
--- a/iokit/Kernel/arm/SweetCPU.cpp
+++ b/iokit/Kernel/arm/SweetCPU.cpp
@@ -183,6 +183,54 @@ vince_cpu_clock_init(void)
 
 	IOLog("VINCE CLK: APCS PLL locked (L=%u), both clusters set to A53 PLL (0x501)\n", l_val);
 }
+
+#if defined(KUGO)
+/*
+ * MSM8956 CPU clocks (Android DT qcom,cpu-clock-8976): the A53 cluster (c0) mux at 0x0b111050, the A72
+ * cluster (c1) at 0x0b011050, the CCI at 0x0b1d1050 (CMD +0, CFG +4: src_sel bits 8-10, 0 XO, 4 GPLL0,
+ * 5 the cluster PLL; div bits 0-4 = 2 div - 1); their PLLs at 0x0b116000 (A53 SR PLL), 0x0b016000 (A72 HF
+ * PLL), 0x0b1d0000 (CCI). Measured: the A53s run at 799 MHz, LK's GPLL0; the A72s sit on XO. The state
+ * is logged; kugoa72=1 gives the A72 cluster cluster 0's GPLL0 source (vince 0115), which needs nothing
+ * from VDD_APC1 beyond what LK left (Linux runs the A72s at 400-883 MHz on corner 1-2).
+ */
+static void
+kugo_cpu_clocks(void)
+{
+	static const uint32_t mux_pa[3] = {0x0b111000, 0x0b011000, 0x0b1d1000};
+	static const uint32_t pll_pa[3] = {0x0b116000, 0x0b016000, 0x0b1d0000};
+	static const char *const name[3] = {"A53", "A72", "CCI"};
+	volatile uint32_t *mux[3], *pll[3];
+	for (int i = 0; i < 3; i++) {
+		mux[i] = (volatile uint32_t *)(ml_io_map(mux_pa[i], 0x1000) + 0x50);
+		pll[i] = (volatile uint32_t *)ml_io_map(pll_pa[i], 0x1000);
+		if ((uintptr_t)mux[i] == 0x50 || pll[i] == NULL) {
+			IOLog("KUGO CLK: mapping failed\n");
+			return;
+		}
+		IOLog("KUGO CLK: %s mux cmd %#x cfg %#x; pll mode %#x l %#x/%#x user %#x status %#x %#x\n", name[i],
+		    mux[i][0], mux[i][1], pll[i][0], pll[i][1], pll[i][2], pll[i][6], pll[i][9], pll[i][10]);
+	}
+	int a72 = 0;
+	PE_parse_boot_argn("kugoa72", &a72, sizeof(a72));
+	uint32_t cfg0 = mux[0][1], old = mux[1][1];
+	if (!a72) {
+		return;
+	}
+	if (((old >> 8) & 7) != 0 || ((cfg0 >> 8) & 7) != 4) {
+		IOLog("KUGO CLK: A72 mux %#x, A53 mux %#x: not XO / GPLL0, left alone\n", old, cfg0);
+		return;
+	}
+	mux[1][1] = cfg0;
+	__builtin_arm_dsb(DSB_SY);
+	mux[1][0] = mux[1][0] | 1;      /* UPDATE */
+	__builtin_arm_dsb(DSB_SY);
+	int i = 0;
+	while ((mux[1][0] & 1) && i++ < 1000) {
+		IODelay(1);
+	}
+	IOLog("KUGO CLK: A72 mux %#x -> %#x (GPLL0, as the A53s)%s\n", old, mux[1][1], (mux[1][0] & 1) ? ", update stuck" : "");
+}
+#endif
 static uint32_t gVinceBootRegistered;   /* the boot CPU finished processor_start */
 static uint32_t gVinceStarted;
 static uint32_t gVinceStartBusy;        /* one secondary at a time through register + start + wait */
@@ -293,7 +341,8 @@ SweetCPU::start(IOService *provider)
 #if defined(VINCE)
 	if (boot) {
 #if defined(KUGO)
-		/* MSM8956 clusters (A53 / A72) have their own PLLs and muxes; leave LK's clocks alone. */
+		/* MSM8956 clusters (A53 / A72) have their own PLLs and muxes: logged, the A72 one on request */
+		kugo_cpu_clocks();
 		vm_offset_t marks = ml_io_map(KUGO_CTL_PAGE_PHYS, 0x1000);
 #else
 		vince_cpu_clock_init();
