+/*
+ * kugoa53=MHZ (SweetCPU's finishStart): the A53 cluster from LK's GPLL0 (800 MHz) to its own SR PLL at
+ * MHZ rounded down to 19.2 MHz steps, at most 1401.6 (L 73, the top of the DT's c0 table). The PLL is the
+ * block ios-vince runs MSM8953's A53s from at the same address (0x0b116000; mode 0, L 8, user 0x18, config
+ * 0x20/0x24, test 0x30/0x34; mux src 5), so its sequence is reused. VDD_APC0 (PM8950 S5, FTS2.5 range 0:
+ * 80 mV + 5 mV a step; LK leaves 1050 mV, fuse corner 2's ceiling) goes first to 1165 mV, the DT ceiling of
+ * fuse corner 3 (1017.6-1401.6 MHz); without CPR closed loop the ceiling is the safe value. Any failure
+ * leaves the cluster on GPLL0 (and the rail as LK had it).
+ */
+#define KUGO_APC0_PPID  0x120
+bool kugo_a53_boost(void);
+
+bool
+kugo_a53_boost(void)
+{
+	int mhz = 0;
+	if (!PE_parse_boot_argn("kugoa53", &mhz, sizeof(mhz)) || mhz <= 800) {
+		return false;
+	}
+	uint32_t l = (uint32_t)mhz * 10 / 192;
+	if (l > 73) {
+		l = 73;
+	}
+	uint8_t range = 0xff, v0 = 0, v1 = 0;
+	if (!kugo_pmic_read(KUGO_APC0_PPID, 0x40, &range) || range != 0 || !kugo_pmic_read(KUGO_APC0_PPID, 0x41, &v0)) {
+		printf("KUGO CPU: VDD_APC0 range %02x unreadable or not range 0, A53s stay at 800 MHz\n", range);
+		return false;
+	}
+	uint8_t vset = (uint8_t)((1165 - 80) / 5);
+	bool vok = kugo_pmic_write(KUGO_APC0_PPID, 0x41, vset);
+	delay(2000);
+	vok = vok && kugo_pmic_read(KUGO_APC0_PPID, 0x41, &v1) && v1 == vset;
+	printf("KUGO CPU: VDD_APC0 %u -> %u mV %s\n", 80 + 5 * v0, 80 + 5 * v1, vok ? "ok" : "FAILED");
+	if (!vok) {
+		(void)kugo_pmic_write(KUGO_APC0_PPID, 0x41, v0);
+		return false;
+	}
+	vm_offset_t pll = ml_io_map(0x0b116000, 0x1000), mux = ml_io_map(0x0b111000, 0x1000);
+	if (pll == 0 || mux == 0) {
+		return false;
+	}
+	wr(pll, 0x00, 0);                       /* off, in case LK left it running */
+	wr(pll, 0x20, 0x200d4828);              /* CONFIG_CTL_LO */
+	wr(pll, 0x24, 0x00000006);              /* CONFIG_CTL_HI */
+	wr(pll, 0x30, 0x1c000000);              /* TEST_CTL_LO */
+	wr(pll, 0x34, 0x00004000);              /* TEST_CTL_HI */
+	wr(pll, 0x18, 0x00000109);              /* USER_CTL: post div, early and main outputs */
+	wr(pll, 0x08, l);
+	wr(pll, 0x00, 0x2);                     /* BYPASSNL */
+	delay(10);
+	wr(pll, 0x00, 0x6);                     /* | RESET_N */
+	bool locked = false;
+	for (int i = 0; i < 1000 && !(locked = (rd(pll, 0x00) & (1u << 31)) != 0); i++) {
+		delay(10);
+	}
+	if (!locked) {
+		printf("KUGO CPU: A53 PLL L %u did not lock (mode %#x), A53s stay at 800 MHz\n", l, rd(pll, 0x00));
+		wr(pll, 0x00, 0);
+		(void)kugo_pmic_write(KUGO_APC0_PPID, 0x41, v0);
+		return false;
+	}
+	wr(pll, 0x00, 0x7);                     /* | OUTCTRL */
+	uint32_t old = rd(mux, 0x54);
+	wr(mux, 0x54, 0x501);                   /* src 5 (the PLL), div 1 */
+	wr(mux, 0x50, rd(mux, 0x50) | 1);       /* UPDATE */
+	int i = 0;
+	while ((rd(mux, 0x50) & 1) && i++ < 1000) {
+		delay(1);
+	}
+	printf("KUGO CPU: A53 PLL locked at L %u (%u.%u MHz), mux %#x -> %#x%s\n", l, l * 192 / 10, l * 192 % 10,
+	    old, rd(mux, 0x54), (rd(mux, 0x50) & 1) ? ", update stuck" : "");
+	return true;
+}
