+		kugo_kick_timeouts++;
+		if (kugo_kick_timeouts <= 3 || (kugo_kick_timeouts & 0xff) == 0) {
+			kugo_panel_dump("flip timeout");
+		}
+	}
+	kugo_flip_inflight = 0;
+}
