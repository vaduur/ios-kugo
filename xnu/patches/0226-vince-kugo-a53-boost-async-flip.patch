+/*
+ * AppleCLCD's double-buffered GPU frames: once the previous frame is out (the caller polls
+ * kugo_panel_idle() sleeping, so the wait here is short), point the 32-bpp pipe at pa and START without
+ * waiting for this one. The GPU draws the next frame into the other buffer meanwhile.
+ */
+bool kugo_panel_idle(void);
+bool kugo_panel_flip(uint64_t pa);
+
+bool
+kugo_panel_idle(void)
+{
+	return fbcon_mdss == NULL || !kugo_flip_inflight ||
+	       (*(volatile uint32_t *)(fbcon_mdss + KUGO_MDP_INTR_STATUS) & (1u << KUGO_PP0_DONE_BIT)) != 0;
+}
+
+bool
+kugo_panel_flip(uint64_t pa)
+{
+	if (fbcon_mdss == NULL || kugo_sspp < 0 || kugo_autorefresh) {
+		return false;
+	}
+	boolean_t istate = ml_set_interrupts_enabled(FALSE);
+	bool held = kugo_spin_lock(&kugo_kick_lock);
+	kugo_flip_drain();
+	KUGO_MDSS_REG(kugo_sspp_off[kugo_sspp] + 0x14) = (uint32_t)pa;
+	__asm__ volatile ("dsb sy" ::: "memory");
+	KUGO_MDSS_REG(0x2018) = kugo_sspp_flush[kugo_sspp];
+	KUGO_MDSS_REG(KUGO_MDP_INTR_CLEAR) = 1u << KUGO_PP0_DONE_BIT;
+	KUGO_MDSS_REG(KUGO_CTL0_START) = 1;
+	__asm__ volatile ("dsb sy" ::: "memory");
+	kugo_flip_inflight = 1;
+	kugo_spin_unlock(&kugo_kick_lock, held);
+	ml_set_interrupts_enabled(istate);
+	return true;
+}
