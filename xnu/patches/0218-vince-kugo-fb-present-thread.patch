+#if defined(KUGO)
+void
+AppleCLCD::presentCall(thread_call_param_t p0, __unused thread_call_param_t p1)
+{
+	AppleCLCD *fb = (AppleCLCD *)p0;
+	uint8_t *rec = (uint8_t *)IOMallocData(SWEET_FB_SWAP_REC_SIZE);
+	if (rec == NULL) {
+		return;
+	}
+	IOLockLock(fb->fLock);
+	bool show = fb->fShowPending && !fb->fPowerOff;
+	if (show) {
+		memcpy(rec, fb->fShow, SWEET_FB_SWAP_REC_SIZE);
+		fb->fShowPending = false;
+	}
+	IOLockUnlock(fb->fLock);
+	if (show) {
+		fb->present(rec);
+	}
+	IOFreeData(rec, SWEET_FB_SWAP_REC_SIZE);
