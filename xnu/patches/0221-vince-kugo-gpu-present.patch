+{
+	for (int i = 0; i < 8; i++) {
+		if (KUGO_MDSS_REG(kugo_sspp_off[i] + 0x14) == KUGO_FB_PHYS) {
+			kugo_sspp = i;
+			kugo_sspp_fmt24 = KUGO_MDSS_REG(kugo_sspp_off[i] + 0x30);
+			kugo_sspp_unpack24 = KUGO_MDSS_REG(kugo_sspp_off[i] + 0x34);
+			break;
+		}
+	}
+	kugo_plog_str("KUGO MDP pipe: ");
+	kugo_plog_hex("index", (uint32_t)kugo_sspp);
