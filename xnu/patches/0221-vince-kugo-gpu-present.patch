+	bool held = kugo_spin_lock(&kugo_kick_lock);
+	KUGO_MDSS_REG(b + 0x14) = pa ? (uint32_t)pa : KUGO_FB_PHYS;
+	KUGO_MDSS_REG(b + 0x24) = pa ? stride : KUGO_FB_STRIDE;
+	KUGO_MDSS_REG(b + 0x30) = fmt;
+	KUGO_MDSS_REG(b + 0x34) = unpack;
