+/*
+ * GPU VA of all of s's pixels, mapped read-only once and kept (s retained) for later frames; the least
+ * recently used of the four slots goes. A new mapping drops every CPU cache line over the surface first
+ * (the kernel's zero-fill may still sit dirty in the cache); after that the quads flush only pages a user
+ * mapping wrote (SWEET_GPU_QUAD_GPUBUF). 0 if it cannot be mapped.
+ */
+uint64_t
+AppleCLCD::gpuMap(SweetSurface *s)
+{
+	unsigned victim = 0;
+	for (unsigned i = 0; i < sizeof(fGpuMaps) / sizeof(fGpuMaps[0]); i++) {
+		if (fGpuMaps[i].s == s) {
+			fGpuMaps[i].used = ++fGpuUse;
+			return fGpuMaps[i].gva;
+		}
+		if (fGpuMaps[i].used < fGpuMaps[victim].used) {
+			victim = i;
+		}
+	}
+	IOMemoryDescriptor *md = s->memory;
+	uint64_t size = md != NULL ? md->getLength() : 0;
+	if (size == 0 || (size & PAGE_MASK) || size > (64ull << 20)) {
+		return 0;
+	}
+	if (fGpuMaps[victim].s != NULL) {
+		sweet_gpu_vm_unmap(fGpuMaps[victim].gva);
+		fGpuMaps[victim].s->memory->complete();
+		fGpuMaps[victim].s->release();
+		fGpuMaps[victim].s = NULL;
+		fGpuMaps[victim].gva = fGpuMaps[victim].used = 0;
+	}
+	if (md->prepare(kIODirectionOut) != kIOReturnSuccess) {
+		return 0;
+	}
+	uint32_t npages = (uint32_t)(size / PAGE_SIZE);
+	uint64_t *pa = (uint64_t *)IOMallocData(npages * sizeof(uint64_t));
+	bool ok = pa != NULL;
+	for (uint32_t p = 0; ok && p < npages; p++) {
+		IOByteCount seg = 0;
+		pa[p] = md->getPhysicalSegment((IOByteCount)p * PAGE_SIZE, &seg, kIOMemoryMapperNone);
+		ok = pa[p] != 0 && (pa[p] & PAGE_MASK) == 0 && seg >= PAGE_SIZE;
+		if (ok && pmap_valid_page((ppnum_t)(pa[p] >> PAGE_SHIFT))) {
+			pmap_clear_modify((ppnum_t)(pa[p] >> PAGE_SHIFT));
+			kugo_flush_dcache64((addr64_t)pa[p], PAGE_SIZE, TRUE);
+		}
+	}
+	uint64_t gva = ok ? sweet_gpu_vm_map(pa, npages, true) : 0;
+	if (pa != NULL) {
+		IOFreeData(pa, npages * sizeof(uint64_t));
+	}
+	if (gva == 0) {
+		md->complete();
+		return 0;
+	}
+	s->retain();
+	fGpuMaps[victim].s = s;
+	fGpuMaps[victim].gva = gva;
+	fGpuMaps[victim].used = ++fGpuUse;
+	return gva;
+}
