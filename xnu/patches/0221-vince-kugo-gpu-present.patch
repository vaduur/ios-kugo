+/* One debug-mux count against 0x800 XO/4 ticks (427 us). */
+static uint32_t
+dbg_count(vm_offset_t g)
+{
+	wr(g, 0x74004, 0x800);
+	for (int i = 0; i < 1000000 && (rd(g, 0x74008) & (1u << 25)); i++) {
+	}
+	wr(g, 0x74004, (1u << 20) | 0x800);
+	for (int i = 0; i < 10000000 && !(rd(g, 0x74008) & (1u << 25)); i++) {
+	}
+	return rd(g, 0x74008) & 0x1ffffffu;
+}
+
+/*
+ * Read-only clock survey through the GCC debug mux (downstream clock-gcc-8916.c / -8976.c:
+ * GCC_DEBUG_CLK_CTL 0x74000 select [8:0] + enable bit 16, CLOCK_FRQ_MEASURE_CTL/STATUS 0x74004/8 counting
+ * against XO/4 from XO_DIV4_CBCR 0x30034, PLLTEST_PAD_CFG 0x7400c): every selector that runs, "sel:MHz",
+ * to read the DDR (bimc) and gfx3d rates off; then this CPU's cycle counter over 2 ms. The debug registers
+ * are restored.
+ */
+static void
+kugo_clocks(const char *when)
+{
+	vm_offset_t g = mmcc;
+	if (g == 0) {
+		return;
+	}
+	uint32_t ctl = rd(g, 0x74000), pad = rd(g, 0x7400c), cbcr = rd(g, 0x30034);
+	wr(g, 0x7400c, 0x51a00);
+	wr(g, 0x30034, cbcr | 1u);
+	char line[200];
+	int n = 0;
+	for (uint32_t sel = 0; sel < 0x200; sel++) {
+		wr(g, 0x74000, sel | (1u << 16));
+		uint32_t c = dbg_count(g);
+		if (c < 5) {
+			continue;
+		}
+		n += snprintf(line + n, sizeof(line) - (size_t)n, " %x:%u", sel, (uint32_t)((uint64_t)c * 4800 / 0x800 / 1000));
+		if (n > 150) {
+			printf("SWEET GPU: clocks %s:%s\n", when, line);
+			n = 0;
+		}
+	}
+	if (n > 0) {
+		printf("SWEET GPU: clocks %s:%s\n", when, line);
+	}
+	wr(g, 0x74000, ctl);
+	wr(g, 0x7400c, pad);
+	wr(g, 0x30034, cbcr);
+
+	uint64_t pmcr, c0, c1, t0, t1;
+	__asm__ volatile ("mrs %0, PMCR_EL0" : "=r"(pmcr));
+	__asm__ volatile ("msr PMCR_EL0, %0" : : "r"(pmcr | 1ull));
+	__asm__ volatile ("msr PMCCFILTR_EL0, %0" : : "r"(0ull));
+	__asm__ volatile ("msr PMCNTENSET_EL0, %0" : : "r"(1ull << 31));
+	boolean_t istate = ml_set_interrupts_enabled(FALSE);
+	int cpu = cpu_number();
+	t0 = mach_absolute_time();
+	__asm__ volatile ("isb; mrs %0, PMCCNTR_EL0" : "=r"(c0));
+	do {
+		t1 = mach_absolute_time();
+	} while (usecs(t1 - t0) < 2000);
+	__asm__ volatile ("isb; mrs %0, PMCCNTR_EL0" : "=r"(c1));
+	ml_set_interrupts_enabled(istate);
+	printf("SWEET GPU: CPU %d runs at %llu MHz (cycle counter, PMCR %llx)\n", cpu, (c1 - c0) / usecs(t1 - t0), pmcr);
+}
