+	KUGO_MDSS_REG(0x2018) = kugo_sspp_flush[kugo_sspp];
+	__asm__ volatile ("dsb sy" ::: "memory");
+	kugo_spin_unlock(&kugo_kick_lock, held);
+	ml_set_interrupts_enabled(istate);
+	kugo_plog_str(pa ? "KUGO MDP: 32-bpp scanout " : "KUGO MDP: 24-bpp scanout ");
+	kugo_plog_hex("fmt", fmt);
+	kugo_plog_hex("unpack", unpack);
+	kugo_plog_putc('\n');
+	return true;
+}
