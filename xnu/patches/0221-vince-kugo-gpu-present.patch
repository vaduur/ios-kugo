+/* num / den as float bits (the kernel has no FP), rounded to nearest. */
+static uint32_t
+sweet_f32(int64_t num, int64_t den)
+{
+	if (num == 0 || den <= 0) {
+		return 0;
+	}
+	uint32_t sign = num < 0 ? 0x80000000u : 0;
+	uint64_t n = (uint64_t)(num < 0 ? -num : num), d = (uint64_t)den;
+	int e = 0;
+	while (n / d >= (1ull << 24)) {
+		d <<= 1;
+		e++;
+	}
+	while (n / d < (1ull << 23)) {
+		n <<= 1;
+		e--;
+	}
+	uint64_t m = (n + d / 2) / d;
+	if (m == (1ull << 24)) {
+		m >>= 1;
+		e++;
+	}
+	return sign | (uint32_t)(e + 23 + 127) << 23 | (uint32_t)(m & 0x7fffff);
+}
