+
+/*
+ * AppleCLCD: scan out the 32-bpp XRGB8888 frame at pa (stride bytes), or the console's 24-bpp splash buffer
+ * again (pa 0). Takes effect with the next kick (CTL_FLUSH latches the double-buffered pipe registers at
+ * START); runs under the kick lock, so never against a frame in flight. False if LK's pipe was not found.
+ */
+bool kugo_panel_rgb32(uint64_t pa, uint32_t stride);
+
+bool
+kugo_panel_rgb32(uint64_t pa, uint32_t stride)
+{
+	if (fbcon_mdss == NULL || kugo_sspp < 0 || kugo_autorefresh) {
+		return false;
+	}
+	uint32_t b = kugo_sspp_off[kugo_sspp];
+	/* 24 bpp -> 32: cpp 4, 4 elements, element 3 alpha (not blended: alpha enable stays off) */
+	uint32_t fmt = pa ? ((kugo_sspp_fmt24 & ~(0x600u | 0x3000u | 0x100u)) | (3u << 9) | (3u << 12) | (3u << 6))
