+/*
+ * Each enabled layer as one quad, logical display -> panel (fShadowW x fShadowH -> fOutW x fHeight at
+ * column fBarX), bilinear; the first one copies, the rest blend source-over. Then the MDP is switched to
+ * the 32-bpp frame (once) and kicked. False (nothing shown) if a layer cannot go through the GPU: the CPU
+ * path takes the frame.
+ */
+bool
+AppleCLCD::presentGPU(const uint8_t *rec)
+{
+	if (!fGpuPresent || !sweet_gpu_ready()) {
+		return false;
+	}
+	uint64_t t0 = mach_absolute_time();
+	if (fFb32Gva == 0) {
+		uint32_t fbBytes = (uint32_t)round_page((uint64_t)KUGO_FB32_STRIDE * fHeight), npages = fbBytes / PAGE_SIZE;
+		IOMemoryDescriptor *pm = IOMemoryDescriptor::withPhysicalAddress(KUGO_FB32_PHYS, fbBytes, kIODirectionInOut);
+		IOMemoryMap *map = pm != NULL ? pm->map(kIOMapWriteCombineCache) : NULL;
+		if (map != NULL) {
+			volatile uint64_t *p = (volatile uint64_t *)map->getVirtualAddress();
+			for (uint32_t i = 0; i < fbBytes / 8; i++) {
+				p[i] = 0;
+			}
+			__asm__ volatile ("dsb sy" ::: "memory");
+			map->release();
+		}
+		OSSafeReleaseNULL(pm);
+		uint64_t *pa = (uint64_t *)IOMallocData(npages * sizeof(uint64_t));
+		if (pa != NULL) {
+			for (uint32_t p = 0; p < npages; p++) {
+				pa[p] = KUGO_FB32_PHYS + (uint64_t)p * PAGE_SIZE;
+			}
+			fFb32Gva = sweet_gpu_vm_map(pa, npages, false);
+			IOFreeData(pa, npages * sizeof(uint64_t));
+		}
+		IOLog("SWEET FB: GPU present: 32-bpp frame at 0x%x %s\n", KUGO_FB32_PHYS, fFb32Gva ? "mapped" : "NOT mapped");
+		if (fFb32Gva == 0) {
+			fGpuPresent = false;
+			return false;
+		}
+	}
+	uint32_t mask = get32(rec, 0x104);
+	bool drawn = false;
+	for (uint32_t layer = 0; layer < SWEET_FB_LAYERS; layer++) {
+		uint32_t id = get32(rec, 0x54 + 4 * layer);
+		const uint8_t *a = rec + 0x64 + 16 * layer;
+		const uint8_t *b = rec + 0xc4 + 16 * layer;
+		int32_t sx = (int32_t)get32(a, 0), sy = (int32_t)get32(a, 4);
+		int32_t dx = (int32_t)get32(b, 0), dy = (int32_t)get32(b, 4);
+		int32_t w = (int32_t)get32(b, 8), h = (int32_t)get32(b, 12);
+		if (!(mask & (1u << layer)) || id == 0) {
+			continue;
+		}
+		SweetSurface *s = sweet_surface_copy(id);
+		if (s == NULL || s == fSurface) {
+			OSSafeReleaseNULL(s);
+			continue;
+		}
+		/* the same clipping as the CPU copy, in logical coordinates */
+		if (w <= 0 || h <= 0) {
+			w = (int32_t)s->width;
+			h = (int32_t)s->height;
+		}
+		if (sx < 0 || sy < 0) {
+			sx = sy = 0;
+		}
+		if (dx < 0 || dy < 0) {
