+static const uint32_t kugo_sspp_off[8] = {0x5000, 0x7000, 0x9000, 0x15000, 0x17000, 0x19000, 0x25000, 0x27000};
+static const uint32_t kugo_sspp_flush[8] = {1u << 0, 1u << 1, 1u << 2, 1u << 3, 1u << 4, 1u << 5, 1u << 11, 1u << 12};
