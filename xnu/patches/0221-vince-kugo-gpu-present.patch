+		kugo_plog_hex("off", b);
+		kugo_plog_hex("size", KUGO_MDSS_REG(b + 0x00));
+		kugo_plog_hex("img", KUGO_MDSS_REG(b + 0x04));
+		kugo_plog_hex("out", KUGO_MDSS_REG(b + 0x0c));
+		kugo_plog_hex("ystride", KUGO_MDSS_REG(b + 0x24));
