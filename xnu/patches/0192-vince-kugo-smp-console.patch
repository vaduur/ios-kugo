 static uint32_t fbcon_quiet;            /* iOS owns the panel: output only goes to the pstore mirror */
 
+/*
+ * With more than one CPU, printf and kprintf reach the console from several cores at once, each kicking
+ * the panel: one START in the middle of another core's frame desyncs it for good. Both the drawing and
+ * the kick take a spinlock (interrupts off). The wait is bounded so a panic on a core that holds it
+ * still prints.
+ */
+static uint32_t fbcon_lock, kugo_kick_lock;
+
+static bool
+kugo_spin_lock(uint32_t *lock)
+{
+	for (unsigned int i = 0; i < 20000000u; i++) {
+		if (os_atomic_cmpxchg(lock, 0, 1, acquire)) {
+			return true;
+		}
+	}
+	return false;
+}
+
+static void
+kugo_spin_unlock(uint32_t *lock, bool held)
+{
+	if (held) {
+		os_atomic_store(lock, 0, release);
+	}
+}
