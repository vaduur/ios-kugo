+/*
+ * GPU SMMU (ARM SMMUv2, 2 context banks, 4 KB pages, CBs from 0x8000):
+ * firmware ignores sCR0.CLIENTPD (bypass) and the stream starts as FAULT
+ * (0120a: S2CR0 0x000200ff, the first CP fetch reset the phone). Like
+ * mainline (which translates through a context bank on MSM8996), but with
+ * an identity map: context bank 0, stage 1 AArch64, 4 KB granule, 36-bit
+ * VA = PA, 1 GB blocks for 0x80000000-0x1ffffffff (DRAM), normal
+ * non-cacheable; SMR0 = stream 0 only, as the Pixel kernel (stream 2 is
+ * TZ's gfx3d_secure: an SMR matching every stream stalled the CPU on the
+ * S2CR write in 0122a, the firmware traps it). Returns false (and the GPU
+ * must not touch memory) unless every write reads back.
+ */
+/* Traced SMMU write: 0121a stalled a CPU on one of them. */
+#define SWR(base, off, val) do { \
+	printf("SWEET GPU: smmu wr %s+0x%x = %08x\n", #base, (unsigned)(off), (unsigned)(val)); \
+	wr(base, off, val); \
+} while (0)
+
+static uint64_t *g_l1, g_l1_pa;  /* context bank 0 L1 table (64 x 1 GB) */
+
+static bool
+smmu_identity(vm_offset_t smmu)
+{
+	vm_offset_t pt_va;
+	uint64_t pt = gpu_page(&pt_va);
+	if (pt == 0) {
+		printf("SWEET GPU: no page-table page\n");
+		return false;
+	}
+	printf("SWEET GPU: page table at %llx\n", pt);
+	uint64_t *l1 = (uint64_t *)pt_va;
+	g_l1 = l1;
+	g_l1_pa = pt;
+#if defined(KUGO)
+	for (uint64_t gb = 1; gb < 4; gb++) {   /* kugo DRAM 0x40000000-0xffffffff (3 GB) */
+#else
+	for (uint64_t gb = 2; gb < 8; gb++) {
+#endif
+		/* block | AttrIndx 0 | AP[1] (EL0 too) | SH outer | AF */
+		l1[gb] = (gb << 30) | 1u | (1u << 6) | (2u << 8) | (1u << 10);
+	}
+	flush_dcache64((addr64_t)pt, PAGE_SIZE, TRUE);
+	vm_offset_t gr1 = smmu + 0x1000, cb = smmu + 0x8000;
+	SWR(cb, 0x0, 0);                         /* SCTLR off while configuring */
+	SWR(gr1, 0x0, 1u << 16);                 /* CBAR0: S1 translate, S2 bypass */
+	SWR(gr1, 0x800, 1u);                     /* CBA2R0: VA64 */
+	SWR(cb, 0x10, (7u << 15) | 1u);          /* TCR2: SEP upstream, PASIZE 36 bit */
+	SWR(cb, 0x30, 28u | (1u << 23));         /* TCR: T0SZ 28, TG0 4K, walks NC, EPD1 */
+	SWR(cb, 0x38, 0x44u);                    /* MAIR0: attr0 normal non-cacheable */
+	SWR(cb, 0x20, (uint32_t)pt);             /* TTBR0, ASID 0 */
+	SWR(cb, 0x24, (uint32_t)(pt >> 32));
+	SWR(cb, 0x58, 0xffffffffu);              /* FSR: clear */
+	/*
+	 * AFE TRE M, no CFRE: a faulting access is terminated without an abort
+	 * to the GPU (reads 0, writes dropped). Texture/vertex fetch reads a
+	 * little past buffer ends; with CFRE that hung the GPU (0154a/c).
+	 * Faults are still recorded in FSR/FAR: sweet_gpu_submit logs them.
+	 */
+	SWR(cb, 0x0, (1u << 2) | (1u << 1) | 1u);
+	SWR(smmu, 0x800, 1u << 31);             /* SMR0: stream 0 (gfx3d_user), mask 0 */
+	SWR(smmu, 0xc00, 0);                     /* S2CR0: translate, context bank 0 */
+	SWR(smmu, 0x68, 0);                      /* TLBIALLNSNH */
+	SWR(smmu, 0x70, 0);                      /* sTLBGSYNC */
+	bool synced = poll(smmu, 0x74, 1u, 0, 10);
+	uint32_t smr = rd(smmu, 0x800), s2cr = rd(smmu, 0xc00), cbar = rd(gr1, 0x0);
+	uint32_t sctlr = rd(cb, 0x0), tcr = rd(cb, 0x30), ttbr = rd(cb, 0x20);
+	bool ok = synced && smr == (1u << 31) && (s2cr & 0x300ff) == 0 &&
+	    (cbar & (3u << 16)) == (1u << 16) && (sctlr & 0x27) == 0x07 && tcr == (28u | (1u << 23)) &&
+	    ttbr == (uint32_t)pt;
+	printf("SWEET GPU: SMMU identity %s: pt %llx SMR0 %08x S2CR0 %08x CBAR0 %08x SCTLR %08x TCR %08x TTBR0 %08x tlbsync %d\n",
+	    ok ? "ok" : "REJECTED", pt, smr, s2cr, cbar, sctlr, tcr, ttbr, synced);
+	return ok;
+}
+
+static void
+smmu_faults(vm_offset_t smmu, const char *when)
+{
+	vm_offset_t cb = smmu + 0x8000;
+	printf("SWEET GPU: %s SMMU sGFSR %08x CB0 FSR %08x FAR %08x%08x FSYNR0 %08x\n", when,
+	    rd(smmu, 0x48), rd(cb, 0x58), rd(cb, 0x64), rd(cb, 0x60), rd(cb, 0x68));
+}
+
+/* Submit everything emitted so far; true once the CP has read it all. */
+static bool
+kick(vm_offset_t gpu)
+{
+	flush_dcache64((addr64_t)rb_pa, PAGE_SIZE, TRUE);
+	gw(gpu, R_CP_RB_WPTR, rb_n);
+	/* spin: delay(1000) here put a 1 ms floor under every quad (0141a) */
+	uint64_t deadline;
+	clock_interval_to_deadline(200, NSEC_PER_MSEC, &deadline);
+	while (gr(gpu, R_CP_RB_RPTR) != rb_n) {
+		if (mach_absolute_time() > deadline) {
+			return false;
+		}
+	}
+	return true;
+}
+
+/* Mesa fd5_blitter.c: one 2D blit, then flush the CCU/UCHE and write fence. */
+static void
+emit_blit(uint32_t op, uint32_t sfmt, uint64_t src, uint32_t spitch, uint32_t sw, uint32_t sh,
+    uint32_t dfmt, uint64_t dst, uint32_t dpitch, uint32_t dw, uint32_t dh, uint64_t fence, uint32_t seq)
+{
+	emit(pkt4(R_UCHE_CACHE_INVALIDATE_MIN, 5));
+	emit(0); emit(0); emit(0); emit(0);
+	emit(0x12);                             /* UCHE_CACHE_INVALIDATE */
+	emit(pkt7(CP_WAIT_FOR_IDLE, 0));
+	/* emit_setup */
+	emit(pkt4(R_RB_RENDER_CNTL, 1)); emit(0x8);
+	emit(pkt4(R_RB_2D_BLIT_CNTL, 1)); emit(0x86000000);
+	emit(pkt4(R_GRAS_2D_BLIT_CNTL, 1)); emit(0x86000000);
+	emit(pkt4(R_UNKNOWN_2184, 1)); emit(0x9);
+	emit(pkt4(R_RB_CNTL, 1)); emit(1u << 17);       /* BYPASS */
+	emit(pkt4(R_RB_MODE_CNTL, 1)); emit(0x4);
+	emit(pkt4(R_SP_MODE_CNTL, 1)); emit(0xc);
+	emit(pkt4(R_TPL1_MODE_CNTL, 1)); emit(0x344);
+	emit(pkt4(R_HLSQ_MODE_CNTL, 1)); emit(0x2);
+	emit(pkt4(R_GRAS_CL_CNTL, 1)); emit(0x181);
+	/* emit_blit; linear, swap WZYX, size = pitch | array pitch, in 64-byte units */
+	emit(pkt7(CP_SET_RENDER_MODE, 1)); emit(op == BLIT_OP_SCALE ? BLIT2DSCALE : BLIT2D);
+	emit(pkt4(R_RB_2D_SRC_INFO, 9));
+	emit(sfmt);
+	emit((uint32_t)src); emit((uint32_t)(src >> 32));
+	emit((spitch >> 6) | (((spitch * sh) >> 6) << 16));
+	emit(0); emit(0); emit(0); emit(0); emit(0);
+	emit(pkt4(R_GRAS_2D_SRC_INFO, 1)); emit(sfmt);
+	emit(pkt4(R_RB_2D_DST_INFO, 9));
+	emit(dfmt);
+	emit((uint32_t)dst); emit((uint32_t)(dst >> 32));
+	emit((dpitch >> 6) | (((dpitch * dh) >> 6) << 16));
+	emit(0); emit(0); emit(0); emit(0); emit(0);
+	emit(pkt4(R_GRAS_2D_DST_INFO, 1)); emit(dfmt);
+	emit(pkt7(CP_BLIT, 5));
+	emit(op);
+	emit(0);                                /* SRC_X1/Y1 */
+	emit((sw - 1) | ((sh - 1) << 16));      /* SRC_X2/Y2 */
+	emit(0);                                /* DST_X1/Y1 */
+	emit((dw - 1) | ((dh - 1) << 16));      /* DST_X2/Y2 */
+	emit(pkt7(CP_SET_RENDER_MODE, 1)); emit(END2D);
+	emit(pkt7(CP_WAIT_FOR_IDLE, 0));
+	emit(pkt7(CP_EVENT_WRITE, 4)); emit(PC_CCU_FLUSH_COLOR_TS);
+	emit((uint32_t)fence); emit((uint32_t)(fence >> 32)); emit(0);
+	emit(pkt7(CP_EVENT_WRITE, 4)); emit(CACHE_FLUSH_TS);
+	emit((uint32_t)fence); emit((uint32_t)(fence >> 32)); emit(seq);
+	emit(pkt7(CP_WAIT_FOR_IDLE, 0));
+}
+
+/*
+ * Qualcomm SCM call, ARM SMCCC (qcom_scm-smc.c): standard call, SMC64, SIP
+ * owner, fn (svc << 8) | cmd, x1 = arginfo, x2-x5 = args. TZ may return
+ * INTERRUPTED (1: call again with x0 = 1, x6 as returned) or
+ * EBUSY (-12: retry later). Returns x0 (0 = ok); *r1 = x1.
+ */
+static int64_t
+scm_call(uint32_t svc, uint32_t cmd, uint32_t arginfo, uint64_t a, uint64_t b, uint64_t c, uint64_t *r1)
+{
+	uint64_t fn = (1ull << 30) | (2ull << 24) | ((uint64_t)svc << 8) | cmd;
+	for (int busy = 0;; busy++) {
+		uint64_t a0 = fn, a6 = 0;
+		register uint64_t x0 __asm__("x0"), x1 __asm__("x1"), x2 __asm__("x2"), x3 __asm__("x3");
+		register uint64_t x4 __asm__("x4"), x5 __asm__("x5"), x6 __asm__("x6"), x7 __asm__("x7");
+		do {
+			x0 = a0; x1 = arginfo; x2 = a; x3 = b; x4 = c; x5 = 0; x6 = a6; x7 = 0;
+			__asm__ volatile("smc #0"
+			    : "+r"(x0), "+r"(x1), "+r"(x2), "+r"(x3), "+r"(x4), "+r"(x5), "+r"(x6), "+r"(x7)
+			    :
+			    : "x8", "x9", "x10", "x11", "x12", "x13", "x14", "x15", "x16", "x17", "memory");
+			a0 = 1;
+			a6 = x6;
+		} while (x0 == 1);
+		if ((int64_t)x0 != -12 || busy >= 20) {
+			if (r1) {
+				*r1 = x1;
+			}
+			return (int64_t)x0;
+		}
+		delay(30000);
+	}
+}
+
+/* ELF32 program header */
+struct zap_phdr {
+	uint32_t type, offset, vaddr, paddr, filesz, memsz, flags, align;
+};
+
+/*
+ * mainline qcom_mdt_load + qcom_scm_pas_auth_and_reset for the split
+ * a530_zap: metadata = the .mdt (ELF header + phdrs + hash segment), one
+ * relocatable loadable segment (the .b02) placed at the carveout start.
+ */
+#if defined(KUGO)
+/* A510 has no zap shader (mainline adreno catalog): leave secure mode directly, as mainline does. */
+static vm_offset_t g_gpu_regs;
+static bool
+zap_load(void)
+{
+	*(volatile uint32_t *)(g_gpu_regs + R_SECVID_TRUST_CNTL * 4) = 0;
+	__builtin_arm_dsb(DSB_SY);
+	uint32_t t = *(volatile uint32_t *)(g_gpu_regs + R_SECVID_TRUST_CNTL * 4);
+	printf("SWEET GPU: A510: RBBM_SECVID_TRUST_CNTL = 0 -> %08x\n", t);
+	return t == 0;
+}
+#else
+static bool
+zap_load(void)
+{
+	uint64_t mdt, seg;
+	uint32_t mdt_len, seg_len;
+	if (!blob("GPU-ZAP-MDT", &mdt, &mdt_len) || !blob("GPU-ZAP-SEG", &seg, &seg_len)) {
+		printf("SWEET GPU: no GPU-ZAP-MDT/GPU-ZAP-SEG in the payload\n");
+		return false;
+	}
+	vm_offset_t meta_va;
+	uint64_t meta = gpu_page(&meta_va);
+	if (meta == 0 || mdt_len > PAGE_SIZE || mdt_len < 0x34) {
+		printf("SWEET GPU: zap metadata %u bytes, no page\n", mdt_len);
+		return false;
+	}
+	memcpy((void *)meta_va, (const void *)phystokv(mdt), mdt_len);
+	const uint8_t *m = (const uint8_t *)meta_va;
+	uint32_t phoff = *(const uint32_t *)(m + 0x1c);
+	uint16_t phnum = *(const uint16_t *)(m + 0x2c);
+	uint32_t lo = ~0u, hi = 0, filesz = 0, memsz = 0, nload = 0;
+	for (uint32_t i = 0; i < phnum && phoff + (i + 1) * 32 <= mdt_len; i++) {
+		const struct zap_phdr *ph = (const struct zap_phdr *)(m + phoff + i * 32);
+		/* PT_LOAD, not the hash segment (type field 2 in flags 26:24), not empty */
+		if (ph->type != 1 || ((ph->flags >> 24) & 7) == 2 || ph->memsz == 0) {
+			continue;
+		}
+		nload++;
+		lo = ph->paddr;
+		hi = (ph->paddr + ph->memsz + 0xfff) & ~0xfffu;
+		filesz = ph->filesz;
+		memsz = ph->memsz;
+	}
+	if (nload != 1 || filesz != seg_len || memsz > ZAP_SIZE) {
+		printf("SWEET GPU: zap layout unexpected: %u loadable, filesz %u seg %u memsz %u\n",
+		    nload, filesz, seg_len, memsz);
+		return false;
+	}
+	flush_dcache64((addr64_t)meta, PAGE_SIZE, TRUE);
+	uint64_t r1 = 0;
+	/* PAS_INIT_IMAGE (svc 2 cmd 1): args (pas id VAL, metadata RW) */
+	int64_t r = scm_call(2, 1, 2u | (2u << 6), GPU_PAS_ID, meta, 0, &r1);
+	printf("SWEET GPU: zap init_image (meta %llx, %u bytes) -> %lld/%llx\n", meta, mdt_len, r, r1);
+	if (r != 0 || r1 != 0) {
+		return false;
+	}
+	/* PAS_MEM_SETUP (svc 2 cmd 2): pas id, base, size */
+	r = scm_call(2, 2, 3, GPU_PAS_ID, ZAP_PA, hi - lo, &r1);
+	printf("SWEET GPU: zap mem_setup %x + %x -> %lld/%llx\n", ZAP_PA, hi - lo, r, r1);
+	if (r != 0 || r1 != 0) {
+		return false;
+	}
+	vm_offset_t zap = ml_io_map(ZAP_PA, ZAP_SIZE);
+	if (zap == 0) {
+		return false;
+	}
+	const uint32_t *src = (const uint32_t *)phystokv(seg);
+	for (uint32_t off = 0; off < ((memsz + 3) & ~3u); off += 4) {
+		wr(zap, off, off < seg_len ? src[off / 4] : 0);
+	}
+	/* PAS_AUTH_AND_RESET (svc 2 cmd 5): pas id */
+	r = scm_call(2, 5, 1, GPU_PAS_ID, 0, 0, &r1);
+	printf("SWEET GPU: zap auth_and_reset -> %lld/%llx\n", r, r1);
+	return r == 0 && r1 == 0;
+}
+
+#endif /* !KUGO: the Pixel's zap_load */
+
+/* Source pixel (x, y) of the RGBA8 test pattern, byte c. */
+static uint8_t
+pat(uint32_t x, uint32_t y, uint32_t c)
+{
+	return (uint8_t)(c == 0 ? x * 4 + 1 : c == 1 ? y * 4 + 2 : c == 2 ? (x + y) * 2 + 3 : 0x80);
+}
+
+/* Step 3: three 2D blits (see the header). */
+static void
+blit_test(vm_offset_t gpu, vm_offset_t smmu, vm_offset_t scratch_va, uint64_t scratch)
+{
+	vm_offset_t sva, d1va, d2va, d3va;
+	uint64_t src = gpu_page(&sva), d1 = gpu_page(&d1va), d2 = gpu_page(&d2va), d3 = gpu_page(&d3va);
+	if (src == 0 || d1 == 0 || d2 == 0 || d3 == 0) {
+		printf("SWEET GPU: no blit pages\n");
+		return;
+	}
+	uint8_t *s = (uint8_t *)sva, *o1 = (uint8_t *)d1va, *o2 = (uint8_t *)d2va, *o3 = (uint8_t *)d3va;
+	for (uint32_t y = 0; y < 64; y++) {
+		for (uint32_t x = 0; x < 64; x++) {
+			for (uint32_t c = 0; c < 4; c++) {
+				s[y * 256 + x * 4 + c] = pat(x, y, c);
+			}
+		}
+	}
+	flush_dcache64((addr64_t)src, PAGE_SIZE, TRUE);
+	flush_dcache64((addr64_t)d1, PAGE_SIZE, TRUE);
+	flush_dcache64((addr64_t)d2, PAGE_SIZE, TRUE);
+	flush_dcache64((addr64_t)d3, PAGE_SIZE, TRUE);
+	uint64_t fence = scratch + 16;
+	volatile uint32_t *fv = (volatile uint32_t *)(scratch_va + 16);
+	printf("SWEET GPU: blit pages src %llx dst %llx %llx %llx\n", src, d1, d2, d3);
+
+	static const char *const name[3] = {"copy RGBA8 64x64", "RGBA8 -> RGB888 64x64", "scale RGBA8 32x32 -> RGB888 46x46"};
+	for (uint32_t t = 0; t < 3; t++) {
+		gpu_wait(2);
+		wr(smmu + 0x8000, 0x58, 0xffffffffu);   /* CB0 FSR: clear the last blit's fault */
+		if (t == 0) {
+			emit_blit(BLIT_OP_COPY, RB5_R8G8B8A8_UNORM, src, 256, 64, 64,
+			    RB5_R8G8B8A8_UNORM, d1, 256, 64, 64, fence, 0x100 + t);
+		} else if (t == 1) {
+			emit_blit(BLIT_OP_COPY, RB5_R8G8B8A8_UNORM, src, 256, 64, 64,
+			    RB5_R8G8B8_UNORM, d2, 192, 64, 64, fence, 0x100 + t);
+		} else {
+			emit_blit(BLIT_OP_SCALE, RB5_R8G8B8A8_UNORM, src, 256, 32, 32,
+			    RB5_R8G8B8_UNORM, d3, 192, 46, 46, fence, 0x100 + t);
+		}
+		bool read = kick(gpu);
+		delay(5000);
+		flush_dcache64((addr64_t)scratch, 64, TRUE);
+		flush_dcache64((addr64_t)d1, PAGE_SIZE, TRUE);
+		flush_dcache64((addr64_t)d2, PAGE_SIZE, TRUE);
+		flush_dcache64((addr64_t)d3, PAGE_SIZE, TRUE);
+		uint32_t bad = 0, nonzero = 0, first = ~0u;
+		for (uint32_t y = 0; y < 64; y++) {
+			for (uint32_t x = 0; x < 64; x++) {
+				for (uint32_t c = 0; c < 4; c++) {
+					uint32_t got, want;
+					if (t == 0) {
+						got = o1[y * 256 + x * 4 + c];
+						want = pat(x, y, c);
+					} else if (t == 1 && c < 3) {
+						got = o2[y * 192 + x * 3 + c];
+						want = pat(x, y, c);
+					} else if (t == 2 && c < 3 && x < 46 && y < 46) {
+						/* nearest; the GPU may sample at pixel centres, so only count */
+						got = o3[y * 192 + x * 3 + c];
+						want = pat(x * 32 / 46, y * 32 / 46, c);
+					} else {
+						continue;
+					}
+					nonzero += got != 0;
+					if (got != want) {
+						if (bad++ == 0) {
+							first = (y << 16) | (x << 4) | c;
+						}
+					}
+				}
+			}
+		}
+		uint8_t *o = t == 0 ? o1 : t == 1 ? o2 : o3;
+		cp_state(gpu, read ? "blit read:" : "blit NOT read (200 ms):");
+		smmu_faults(smmu, "after blit:");
+		printf("SWEET GPU: blit %s: fence %x (want %x), %u nonzero, %u mismatches (first y %u x %u c %u); "
+		    "dst[0..7] %02x %02x %02x %02x %02x %02x %02x %02x -> %s\n",
+		    name[t], *fv, 0x100 + t, nonzero, bad, first >> 16, (first >> 4) & 0xfff, first & 0xf,
+		    o[0], o[1], o[2], o[3], o[4], o[5], o[6], o[7],
+		    bad == 0 ? "GPU 2D BLIT WORKS" : nonzero ? "partly written" : "nothing written");
+		if (!read) {
+			return;
+		}
+	}
+}
+
+/*
+ * GPU VA window 8-16 GB: L1[8..15] -> L2 (512 x 2 MB) -> L3 (512 x 4 KB).
+ * L2/L3 tables are 4 KB, carved from 16 KB pages; L3 tables are allocated
+ * on first use of a 2 MB chunk and kept. Mappings are page (16 KB)
+ * granular, first fit from a rover, each followed by VM_PAD padding pages
+ * that all map one shared scratch page: texture/vertex fetch reads past
+ * buffer ends, and a fault there hung the A530 even with faults
+ * terminated (0154a/c, 0155a), so overruns land in scratch instead.
+ * Mesa makes thousands of small buffers, whole 2 MB chunks ran out at 4096.
+ * g_owner[page] is the mapping index (0 free, VM_GUARD padding).
+ */
+#define GVA_BASE        0x200000000ull
+#define GVA_CHUNKS      4096u                   /* 8 GB / 2 MB */
+#define GVA_PAGES       ((uint32_t)((8ull << 30) / PAGE_SIZE))
+#define VM_MAPS         16384u                  /* index 0 unused */
+#define VM_GUARD        0xffffu
+#define VM_PAD          8u                      /* 128 KB */
+#define PTE_ATTRS       ((1u << 6) | (2u << 8) | (1u << 10))    /* AP[1], SH outer, AF; AttrIndx 0 */
+
+static LCK_GRP_DECLARE(sweet_gpu_grp, "sweet_gpu");
+static LCK_MTX_DECLARE(sweet_gpu_vm_lock, &sweet_gpu_grp);
+static vm_offset_t g_smmu;
+static uint64_t *g_l2[8];
+static uint64_t *g_l3[GVA_CHUNKS];
+struct vm_mapping {
+	uint64_t va;            /* 0: free slot */
+	uint64_t *pa;           /* npages physical page addresses */
+	uint32_t npages;
+	bool ro;
+};
+static struct vm_mapping *g_maps;
+static uint16_t *g_owner;
+static uint32_t g_rover, g_map_rover = 1;
+static uint64_t g_pad_pa[VM_PAD];               /* VM_PAD x the scratch page */
+
+/* A 4 KB table from the current 16 KB pool page; *pa gets its PA. */
+static uint64_t *
+pt4k(uint64_t *pa)
+{
+	static vm_offset_t pool_va;
+	static uint64_t pool_pa;
+	static unsigned pool_left;
+	if (pool_left == 0) {
+		pool_pa = gpu_page(&pool_va);
+		if (pool_pa == 0) {
+			return NULL;
+		}
+		pool_left = PAGE_SIZE / 4096;
+	}
+	unsigned i = PAGE_SIZE / 4096 - pool_left--;
+	*pa = pool_pa + i * 4096;
+	return (uint64_t *)(pool_va + i * 4096);
+}
+
+static void
+smmu_tlb_flush(void)
+{
+	wr(g_smmu, 0x68, 0);    /* TLBIALLNSNH */
+	wr(g_smmu, 0x70, 0);    /* sTLBGSYNC */
+	(void)poll(g_smmu, 0x74, 1u, 0, 10);
+}
+
+static bool
+vm_init(vm_offset_t smmu)
+{
+	g_smmu = smmu;
+	g_maps = kalloc_data(VM_MAPS * sizeof(g_maps[0]), Z_WAITOK | Z_ZERO);
+	g_owner = kalloc_data(GVA_PAGES * sizeof(g_owner[0]), Z_WAITOK | Z_ZERO);
+	vm_offset_t pad_va;
+	uint64_t pad = gpu_page(&pad_va);
+	if (g_maps == NULL || g_owner == NULL || pad == 0) {
+		return false;
+	}
+	for (unsigned i = 0; i < VM_PAD; i++) {
+		g_pad_pa[i] = pad;
+	}
+	for (unsigned gb = 0; gb < 8; gb++) {
+		uint64_t pa;
+		g_l2[gb] = pt4k(&pa);
+		if (g_l2[gb] == NULL) {
+			return false;
+		}
+		g_l1[8 + gb] = pa | 3u;                 /* table */
+	}
+	flush_dcache64((addr64_t)g_l1_pa, 4096, TRUE);
+	smmu_tlb_flush();
+	return true;
+}
+
+/* VM lock held: first page of a free run of n pages (first fit from the rover), or -1. */
+static int64_t
+vm_find(uint32_t n)
+{
+	for (int pass = 0; pass < 2; pass++) {
+		uint32_t start = pass ? 0 : g_rover, end = pass ? g_rover : GVA_PAGES;
+		uint32_t run = 0;
+		for (uint32_t p = start; p < end; p++) {
+			run = g_owner[p] ? 0 : run + 1;
+			if (run == n) {
+				return p + 1 - n;
+			}
+		}
+	}
+	return -1;
+}
+
+/* VM lock held: L3 tables for pages [first, first + n). */
+static bool
+vm_tables(uint32_t first, uint32_t n)
+{
+	uint32_t per = (2u << 20) / PAGE_SIZE;          /* pages per 2 MB chunk */
+	for (uint32_t c = first / per; c <= (first + n - 1) / per; c++) {
+		if (g_l3[c] != NULL) {
+			continue;
+		}
+		uint64_t l3pa;
+		g_l3[c] = pt4k(&l3pa);
+		if (g_l3[c] == NULL) {
+			return false;
+		}
+		bzero(g_l3[c], 4096);
+		flush_dcache64((addr64_t)g_l3[c], 4096, FALSE);
+		uint64_t *l2 = g_l2[c / 512];
+		l2[c % 512] = l3pa | 3u;
+		flush_dcache64((addr64_t)&l2[c % 512], 8, FALSE);
+	}
+	return true;
+}
+
+/* VM lock held: write (pa != NULL) or clear the L3 entries of pages [first, first + n). */
+static void
+vm_ptes(uint32_t first, uint32_t n, const uint64_t *pa, bool readonly)
+{
+	uint32_t sub = PAGE_SIZE / 4096;
+	uint64_t attrs = PTE_ATTRS | (readonly ? 1u << 7 : 0);         /* AP[2]: read-only */
+	uint64_t i0 = (uint64_t)first * sub, i1 = (uint64_t)(first + n) * sub;
+	for (uint64_t i = i0; i < i1; i++) {
+		g_l3[i / 512][i % 512] = pa ? (pa[i / sub - first] + (i % sub) * 4096) | 3u | attrs : 0;
+	}
+	for (uint64_t t = i0 / 512; t <= (i1 - 1) / 512; t++) {
+		flush_dcache64((addr64_t)g_l3[t], 4096, FALSE);
+	}
+}
+
+/*
+ * Map npages kernel pages (16 KB each, physical addresses in pa[]) at a new
+ * GPU VA; returns it, or 0 if out of VA, slots or table memory.
+ */
+uint64_t
+sweet_gpu_vm_map(const uint64_t *pa, uint32_t npages, bool readonly)
+{
+	if (g_maps == NULL || npages == 0 || npages >= GVA_PAGES) {
+		return 0;
+	}
+	uint64_t *pages = kalloc_data(npages * sizeof(uint64_t), Z_WAITOK);
+	if (pages == NULL) {
+		return 0;
+	}
+	memcpy(pages, pa, npages * sizeof(uint64_t));
+	lck_mtx_lock(&sweet_gpu_vm_lock);
+	uint32_t m = 0;
+	for (uint32_t k = 0; k < VM_MAPS - 1 && m == 0; k++) {
+		uint32_t i = 1 + (g_map_rover - 1 + k) % (VM_MAPS - 1);
+		m = g_maps[i].va == 0 ? i : 0;
+	}
+	int64_t first = m ? vm_find(npages + VM_PAD) : -1;
+	if (first < 0 || !vm_tables((uint32_t)first, npages + VM_PAD)) {
+		lck_mtx_unlock(&sweet_gpu_vm_lock);
+		kfree_data(pages, npages * sizeof(uint64_t));
+		return 0;
+	}
+	for (uint32_t p = 0; p < npages; p++) {
+		g_owner[first + p] = (uint16_t)m;
+	}
+	for (uint32_t p = 0; p < VM_PAD; p++) {
+		g_owner[first + npages + p] = VM_GUARD;
+	}
+	g_rover = (uint32_t)first + npages + VM_PAD;
+	g_map_rover = m + 1;
+	uint64_t va = GVA_BASE + (uint64_t)first * PAGE_SIZE;
+	g_maps[m] = (struct vm_mapping){ .va = va, .pa = pages, .npages = npages, .ro = readonly };
+	vm_ptes((uint32_t)first, npages, pages, readonly);
+	vm_ptes((uint32_t)first + npages, VM_PAD, g_pad_pa, false);
+	smmu_tlb_flush();
+	lck_mtx_unlock(&sweet_gpu_vm_lock);
+	return va;
+}
+
+void
+sweet_gpu_vm_unmap(uint64_t va)
+{
+	if (g_maps == NULL || va < GVA_BASE || va - GVA_BASE >= (uint64_t)GVA_PAGES * PAGE_SIZE || (va & PAGE_MASK)) {
+		return;
+	}
+	uint32_t first = (uint32_t)((va - GVA_BASE) / PAGE_SIZE);
+	lck_mtx_lock(&sweet_gpu_vm_lock);
+	uint32_t m = g_owner[first];
+	if (m == 0 || m == VM_GUARD || g_maps[m].va != va) {
+		lck_mtx_unlock(&sweet_gpu_vm_lock);
+		return;
+	}
+	uint32_t n = g_maps[m].npages;
+	uint64_t *pages = g_maps[m].pa;
+	vm_ptes(first, n + VM_PAD, NULL, false);
+	smmu_tlb_flush();
+	for (uint32_t p = 0; p < n + VM_PAD; p++) {
+		g_owner[first + p] = 0;
+	}
+	g_maps[m] = (struct vm_mapping){ 0 };
+	lck_mtx_unlock(&sweet_gpu_vm_lock);
+	kfree_data(pages, n * sizeof(uint64_t));
+}
+
+/* VM lock held: the index of the one mapping holding [va, va + len), or -1. */
+static int
+vm_range(uint64_t va, uint64_t len)
+{
+	if (g_maps == NULL || len == 0 || va < GVA_BASE || va - GVA_BASE >= (uint64_t)GVA_PAGES * PAGE_SIZE) {
+		return -1;
+	}
+	uint32_t m = g_owner[(va - GVA_BASE) / PAGE_SIZE];
+	if (m == 0 || m == VM_GUARD) {
+		return -1;
+	}
+	uint64_t end = g_maps[m].va + (uint64_t)g_maps[m].npages * PAGE_SIZE;
+	return len <= end - va ? (int)m : -1;
+}
+
+/* VM lock held: clean + invalidate the CPU cache over [va, va + len) of mapping m. */
+static void
+vm_cache(uint32_t m, uint64_t va, uint64_t len)
+{
+	uint64_t off = va - g_maps[m].va;
+	for (uint64_t p = off / PAGE_SIZE; p <= (off + len - 1) / PAGE_SIZE; p++) {
+		/* not kernel RAM (the panel buffers): no physmap alias, nothing cached */
+		if (pmap_valid_page((ppnum_t)atop(g_maps[m].pa[p]))) {
+			flush_dcache64((addr64_t)g_maps[m].pa[p], PAGE_SIZE, TRUE);
+		}
+	}
+}
+
+/* Optional dispatch state: constants, textures + samplers, 2-D grid. */
+struct cs_extra {
+	const uint32_t *consts;         /* nconst vec4s, uploaded at c0 */
+	uint32_t nconst;
+	const uint32_t *tex;            /* ntex x 12 dwords (A5XX_TEX_CONST) */
+	const uint32_t *samp;           /* ntex x 4 dwords (A5XX_TEX_SAMP) */
+	uint32_t ntex;
+	uint32_t groups_y;              /* 0 = 1 */
+};
+
+/* A5XX_TEX_CONST for a linear 2-D image: TFMT5_* format, swizzle (4 x 3 bits, x first). */
+static void
+tex_desc(uint32_t *t, uint64_t pa, uint32_t w, uint32_t h, uint32_t pitch, uint32_t fmt, uint32_t swiz)
+{
+	memset(t, 0, 12 * 4);
+	t[0] = ((swiz & 7) << 4) | (((swiz >> 3) & 7) << 7) | (((swiz >> 6) & 7) << 10) | (((swiz >> 9) & 7) << 13) |
+	    (fmt << 22);
+	t[1] = w | (h << 15);
+	t[2] = (pitch << 7) | (1u << 29);                       /* PITCHALIGN 0, 2D */
+	t[3] = ((pitch * h) >> 12) & 0x3fff;                    /* ARRAY_PITCH */
+	t[4] = (uint32_t)pa;                                    /* 32-byte aligned */
+	t[5] = (uint32_t)(pa >> 32) | (1u << 17);               /* DEPTH 1 */
+}
+
+#define TFMT5_8_UNORM           0x03u
+#define TFMT5_8_8_UNORM         0x0fu
+#define TFMT5_8_8_8_8_UNORM     0x30u
+#define SWIZ_XYZW               0x688u
+
+/* A linear RGBA8 2-D image (byte 0 = x). */
+static void
+tex_rgba8(uint32_t *t, uint64_t pa, uint32_t w, uint32_t h, uint32_t pitch)
+{
+	tex_desc(t, pa, w, h, pitch, TFMT5_8_8_8_8_UNORM, SWIZ_XYZW);
+}
+
+/* A5XX_TEX_SAMP: unnormalized coords, clamp to edge, linear or nearest. */
+static void
+samp_unnorm(uint32_t *s, bool linear)
+{
+	uint32_t f = linear ? 1 : 0;
+	s[0] = (f << 1) | (f << 3) | (1u << 5) | (1u << 8) | (1u << 11);
+	s[1] = (1u << 5) | (32u << 8);                         /* UNNORM, MAX_LOD 0.125 */
+	s[2] = 0;
+	s[3] = 0;
+}
+
+/*
+ * One compute dispatch of `groups` x k->local[0] invocations (computerator
+ * a5xx_emit_grid: cs_restore_emit, cs_program_emit, cs_ibo_emit; no consts,
+ * no private memory); the shader binary must already be at shader_pa. Ends
+ * with CACHE_FLUSH_TS writing seq to fence. True if the CP read it all.
+ */
+static bool
+compute_run(vm_offset_t gpu, const struct sweet_kernel *k, uint64_t shader_pa,
+    const uint64_t *buf, const uint32_t *buf_bytes, uint32_t groups, uint64_t fence, uint32_t seq,
+    const struct cs_extra *x)
+{
+	uint32_t gy = x && x->groups_y ? x->groups_y : 1;
+	uint32_t thr = k->double_threadsize ? 1 : 0;     /* FOUR_QUADS : TWO_QUADS */
+
+	/* cs_restore_emit */
+	emit(pkt7(CP_SET_RENDER_MODE, 5)); emit(BYPASS); emit(0); emit(0); emit(0); emit(0);
+	emit(pkt4(R_UCHE_CACHE_INVALIDATE_MIN, 5)); emit(0); emit(0); emit(0); emit(0); emit(0x12);
+	emit(pkt7(CP_WAIT_FOR_IDLE, 0));
+	emit(pkt4(R_HLSQ_UPDATE_CNTL, 1)); emit(0x000fffff);
+	emit(pkt4(R_RB_MODE_CNTL, 1)); emit(0x44);
+	emit(pkt4(R_RB_DBG_ECO_CNTL, 1)); emit(0x00100000);
+	emit(pkt4(R_PC_MODE_CNTL, 1)); emit(0x1f);
+	emit(pkt4(R_SP_MODE_CNTL, 1)); emit(0x1e);
+	emit(pkt4(R_SP_DBG_ECO_CNTL, 1)); emit(0x40000800);     /* not A540 */
+	emit(pkt4(R_TPL1_MODE_CNTL, 1)); emit(0x544);
+	emit(pkt4(R_HLSQ_TIMEOUT_THRESHOLD_0, 2)); emit(0x80); emit(0);
+	emit(pkt4(R_VPC_DBG_ECO_CNTL, 1)); emit(0x400);
+	emit(pkt4(R_HLSQ_MODE_CNTL, 1)); emit(1);
+	emit(pkt4(R_VPC_MODE_CNTL, 1)); emit(0);
+	/* cs_program_emit */
+	emit(pkt4(R_SP_SP_CNTL, 1)); emit(0);
+	emit(pkt4(R_HLSQ_CONTROL_0_REG, 1)); emit((thr << 2) | 0x880);
+	emit(pkt4(R_SP_CS_CTRL_REG0, 1));
+	emit((thr << 3) | ((uint32_t)(k->max_half_reg + 1) << 4) | ((uint32_t)(k->max_reg + 1) << 10) |
+	    (k->branchstack << 24) | (1u << 2) /* BUFFER */ | 0x2);
+	emit(pkt4(R_HLSQ_CS_CONFIG, 1)); emit(1);
+	emit(pkt4(R_HLSQ_CS_CNTL, 1)); emit((k->instrlen << 1) | (k->num_bufs ? 1u : 0));
+	emit(pkt4(R_SP_CS_CONFIG, 1)); emit(1);
+	emit(pkt4(R_HLSQ_CS_CONSTLEN, 2)); emit(k->constlen / 4); emit(k->instrlen);
+	emit(pkt4(R_TPL1_CS_TEX_COUNT, 1)); emit(x ? x->ntex : 0);
+	emit(pkt4(R_SP_CS_OBJ_START, 6));
+	emit((uint32_t)shader_pa); emit((uint32_t)(shader_pa >> 32));
+	emit(0);                                /* PVT_MEM_PARAM */
+	emit(0); emit(0);                       /* PVT_MEM_ADDR */
+	emit(0);                                /* PVT_MEM_SIZE */
+	emit(pkt4(R_HLSQ_UPDATE_CNTL, 1)); emit(0x01f00000);
+	emit(pkt4(R_HLSQ_CS_CNTL_0, 2));
+	emit(k->wgid_regid | (0xfcu << 8) | (0xfcu << 16) | (k->localid_regid << 24));
+	emit(1);                                /* HLSQ_CS_CNTL_1 */
+	emit(pkt7(CP_LOAD_STATE4, 3));
+	emit((2u << 16) | (SB4_CS_SHADER << 18) | (k->instrlen << 22));    /* SS4_INDIRECT */
+	emit((uint32_t)shader_pa);              /* STATE_TYPE ST4_SHADER (0) in bits 1:0 */
+	emit((uint32_t)(shader_pa >> 32));
+	/* constants (computerator emit_const), textures + samplers (fd5 emit_textures) */
+	if (x && x->nconst) {
+		emit(pkt7(CP_LOAD_STATE4, 3 + 4 * x->nconst));
+		emit((SB4_CS_SHADER << 18) | (x->nconst << 22));       /* SS4_DIRECT, DST_OFF 0 */
+		emit(1);                                                /* ST4_CONSTANTS */
+		emit(0);
+		for (uint32_t i = 0; i < 4 * x->nconst; i++) {
+			emit(x->consts[i]);
+		}
+	}
+	if (x && x->ntex) {
+		emit(pkt7(CP_LOAD_STATE4, 3 + 4 * x->ntex));
+		emit((SB4_CS_TEX << 18) | (x->ntex << 22));
+		emit(0);                                                /* ST4_SHADER = samplers */
+		emit(0);
+		for (uint32_t i = 0; i < 4 * x->ntex; i++) {
+			emit(x->samp[i]);
+		}
+		emit(pkt7(CP_LOAD_STATE4, 3 + 12 * x->ntex));
+		emit((SB4_CS_TEX << 18) | (x->ntex << 22));
+		emit(1);                                                /* ST4_CONSTANTS = textures */
+		emit(0);
+		for (uint32_t i = 0; i < 12 * x->ntex; i++) {
+			emit(x->tex[i]);
+		}
+		emit(pkt4(R_TPL1_VS_TEX_COUNT, 4)); emit(0); emit(0); emit(0); emit(0);
+		emit(pkt4(R_TPL1_FS_TEX_COUNT, 1)); emit(0);
+	}
+	/* cs_ibo_emit: SSBO sizes (bytes, overflowing from WIDTH into HEIGHT), then addresses */
+	if (k->num_bufs) {
+		emit(pkt7(CP_LOAD_STATE4, 3 + 2 * k->num_bufs));
+		emit((SB4_CS_SSBO << 18) | (k->num_bufs << 22));
+		emit(1);                        /* ST4_CONSTANTS */
+		emit(0);
+		for (uint32_t i = 0; i < k->num_bufs; i++) {
+			emit((buf_bytes[i] & 0xffffu) << 16);
+			emit(buf_bytes[i] >> 16);
+		}
+		emit(pkt7(CP_LOAD_STATE4, 3 + 2 * k->num_bufs));
+		emit((SB4_CS_SSBO << 18) | (k->num_bufs << 22));
+		emit(2);                        /* ST4_UBO */
+		emit(0);
+		for (uint32_t i = 0; i < k->num_bufs; i++) {
+			emit((uint32_t)buf[i]); emit((uint32_t)(buf[i] >> 32));
+		}
+	}
+	/* grid: groups x gy workgroups */
+	emit(pkt4(R_HLSQ_CS_NDRANGE_0, 7));
+	emit(3u | ((k->local[0] - 1) << 2) | ((k->local[1] - 1) << 12) | ((k->local[2] - 1) << 22));
+	emit(k->local[0] * groups); emit(0);
+	emit(k->local[1] * gy); emit(0);
+	emit(k->local[2]); emit(0);
+	emit(pkt4(R_HLSQ_CS_KERNEL_GROUP_X, 3)); emit(1); emit(1); emit(1);
+	emit(pkt7(CP_EXEC_CS, 4)); emit(0); emit(groups); emit(gy); emit(1);
+	emit(pkt7(CP_WAIT_FOR_IDLE, 0));
+	emit(pkt7(CP_EVENT_WRITE, 4)); emit(CACHE_FLUSH_TS);
+	emit((uint32_t)fence); emit((uint32_t)(fence >> 32)); emit(seq);
+	emit(pkt7(CP_WAIT_FOR_IDLE, 0));
+	return kick(gpu);
+}
+
+/* A kernel's binary in its own page; returns the PA (0 on failure). */
+static uint64_t
+kernel_page(const struct sweet_kernel *k)
+{
+	vm_offset_t va;
+	uint64_t pa = gpu_page(&va);
+	if (pa != 0 && k->size <= PAGE_SIZE) {
+		memcpy((void *)va, k->bin, k->size);
+		flush_dcache64((addr64_t)pa, PAGE_SIZE, TRUE);
+	}
+	return k->size <= PAGE_SIZE ? pa : 0;
+}
+
+/* CPU reference of blend.asm: premultiplied source-over, same rounding. */
+static uint32_t
+blend_ref(uint32_t src, uint32_t dst)
+{
+	uint32_t ia = 255 - (src >> 24), out = 0;
+	for (int sh = 0; sh < 32; sh += 8) {
+		uint32_t t = ((dst >> sh) & 0xff) * ia;
+		out |= (((t + 128 + (t >> 8)) >> 8) & 0xff) << sh;
+	}
+	return src + out;
+}
+
+static uint64_t
+usecs(uint64_t abs)
+{
+	uint64_t ns;
+	absolutetime_to_nanoseconds(abs, &ns);
+	return ns / 1000;
+}
+
+/* CPU blend as fast as plain C gets: blend.asm's two-channels-per-op form. */
+static void
+blend_cpu(const uint32_t *src, uint32_t *dst, uint32_t n)
+{
+	for (uint32_t i = 0; i < n; i++) {
+		uint32_t s = src[i], d = dst[i], ia = 255 - (s >> 24);
+		uint32_t rb = (d & 0x00ff00ffu) * ia, ag = ((d >> 8) & 0x00ff00ffu) * ia;
+		rb = ((rb + 0x00800080u + ((rb >> 8) & 0x00ff00ffu)) >> 8) & 0x00ff00ffu;
+		ag = ((ag + 0x00800080u + ((ag >> 8) & 0x00ff00ffu)) >> 8) & 0x00ff00ffu;
+		dst[i] = s + (rb | (ag << 8));
+	}
+}
+
+/* gfx3d RCG = GPLL0 (600 MHz) / div, div in half steps (field 2*div - 1). */
+static bool
+gfx_clock(uint32_t field)
+{
+#if defined(KUGO)
+	/* GPLL0 800 MHz: field 2*div-1; the Pixel's 300 MHz (3) becomes 266 MHz (div 3 = 5) */
+	uint32_t f = field == 3 ? 5u : field == 5 ? 7u : field;
+	wr(mmcc, G_GFX3D_CFG, (1u << 8) | f);
+	wr(mmcc, G_GFX3D_CMD, rd(mmcc, G_GFX3D_CMD) | 1u);
+	return poll(mmcc, G_GFX3D_CMD, 1u, 0, 10);
+#else
+	wr(mmcc, 0x4004, (5u << 8) | field);
+	wr(mmcc, 0x4000, rd(mmcc, 0x4000) | 1u);
+	return poll(mmcc, 0x4000, 1u, 0, 10);
+#endif
+}
+
+/*
+ * Full-frame benchmark: 1024x1024 pixels (4 MB per buffer, about one
+ * 750x1334 iOS frame), each configuration twice.
+ */
+static void
+bench_test(vm_offset_t gpu, vm_offset_t smmu, vm_offset_t scratch_va, uint64_t scratch)
+{
+	const uint32_t n = 1024 * 1024, bytes = n * 4;
+	vm_offset_t sva, dva, cva;
+	uint64_t src = gpu_alloc(&sva, bytes), dst = gpu_alloc(&dva, bytes), cpu = gpu_alloc(&cva, bytes);
+	uint64_t kb = kernel_page(&k_blend), kb4 = kernel_page(&k_blend4);
+	if (src == 0 || dst == 0 || cpu == 0 || kb == 0 || kb4 == 0) {
+		printf("SWEET GPU: bench: no 4 MB buffers\n");
+		return;
+	}
+	static const struct {
+		const char *name;
+		const struct sweet_kernel *k;
+		uint32_t px_per_inv, clk_field, mhz;
+	} cfg[3] = {
+		{"blend 1px", &k_blend, 1, 5, 200},
+		{"blend4 4px", &k_blend4, 4, 5, 200},
+		{"blend4 4px", &k_blend4, 4, 3, 300},
+	};
+	uint32_t *s = (uint32_t *)sva, *d = (uint32_t *)dva, *c = (uint32_t *)cva;
+	volatile uint32_t *fv = (volatile uint32_t *)(scratch_va + 48);
+	for (uint32_t r = 0; r < 6; r++) {
+		uint32_t ci = r / 2, seq = 0x500 + r;
+		if (r % 2 == 0 && !gfx_clock(cfg[ci].clk_field)) {
+			printf("SWEET GPU: bench: gfx3d clock switch to %u MHz TIMEOUT\n", cfg[ci].mhz);
+			return;
+		}
+		for (uint32_t i = 0; i < n; i++) {
+			uint32_t al = (i * 37 + r) & 0xff, ch = al ? (i * 11) % (al + 1) : 0;
+			s[i] = (al << 24) | (ch << 16) | ((ch / 2) << 8) | (ch / 3);
+			d[i] = c[i] = 0xff000000u | ((i * 7) & 0xff) << 16 | ((i * 13) & 0xff) << 8 | (i & 0xff);
+		}
+		uint64_t t0 = mach_absolute_time();
+		flush_dcache64((addr64_t)src, bytes, TRUE);
+		flush_dcache64((addr64_t)dst, bytes, TRUE);
+		uint64_t t1 = mach_absolute_time();
+		uint64_t bufs[2] = {src, dst};
+		uint32_t sizes[2] = {bytes, bytes};
+		bool read = compute_run(gpu, cfg[ci].k, ci == 0 ? kb : kb4, bufs, sizes,
+		    n / cfg[ci].px_per_inv / 64, scratch + 48, seq, NULL);
+		uint64_t t2 = mach_absolute_time();
+		bool done = false;
+		for (unsigned us = 0; us < 500000 && !(done = (*fv == seq)); us += 10) {
+			delay(10);
+			flush_dcache64((addr64_t)scratch + 48, 4, TRUE);
+		}
+		uint64_t t3 = mach_absolute_time();
+		flush_dcache64((addr64_t)dst, bytes, TRUE);
+		uint64_t t4 = mach_absolute_time();
+		blend_cpu(s, c, n);
+		uint64_t t5 = mach_absolute_time();
+		uint32_t bad = 0, first = ~0u;
+		for (uint32_t i = 0; i < n; i++) {
+			if (d[i] != c[i] && bad++ == 0) {
+				first = i;
+			}
+		}
+		printf("SWEET GPU: bench %u %s @%u MHz: %u px; cache clean+inval 8 MB %llu us; GPU submit %llu us, "
+		    "submit->fence %llu us (%s); inval 4 MB %llu us; CPU blend %llu us; GPU vs CPU %u wrong (first %u)\n",
+		    r, cfg[ci].name, cfg[ci].mhz, n, usecs(t1 - t0), usecs(t2 - t1), usecs(t3 - t1),
+		    done ? "done" : read ? "NO FENCE" : "NOT READ", usecs(t4 - t3), usecs(t5 - t4), bad, first);
+		smmu_faults(smmu, "after bench:");
+		if (!done) {
+			cp_state(gpu, "bench stuck:");
+			return;
+		}
+		gpu_wait(1);
+	}
+	(void)gfx_clock(5);
+}
+
+/* RGBA8 test image pixel (premultiplied: every channel <= alpha). */
+static uint32_t
+src_px(uint32_t x, uint32_t y)
+{
+	uint32_t al = (x * 9 + y * 5 + 40) & 0xff, c = al ? (x * 7 + y * 3) % (al + 1) : 0;
+	return (al << 24) | (c << 16) | ((c / 2) << 8) | (c / 3);
+}
+
+/*
+ * sample.asm checks. A: identity placement of a 64x64 image at (16, 16) in a
+ * 128x128 dst, opacity 1 (expect blend_ref, +-1 for float rounding).
+ * B: 2x upscale over the whole dst, opacity 0.5: bilinear weights are
+ * quarters, so out = (sum16 * 255 + d * (8160 - sum16_a)) / 8160 exactly in
+ * integers (sum16 = 16x the bilinear sum; 8160 = 255 * 32); expect +-2.
+ */
+/* Kernel memory from kernel_memory_allocate (pages not contiguous), mapped at a GPU VA. */
+static uint64_t
+vm_buffer(vm_offset_t *va, uint32_t bytes)
+{
+	uint64_t pa[16];
+	uint32_t npages = (bytes + PAGE_SIZE - 1) / PAGE_SIZE;
+	if (npages > 16 || kmem_alloc(kernel_map, va, npages * PAGE_SIZE, KMA_DATA | KMA_ZERO, VM_KERN_MEMORY_IOKIT) != KERN_SUCCESS) {
+		return 0;
+	}
+	bool contiguous = true;
+	for (uint32_t i = 0; i < npages; i++) {
+		pa[i] = ptoa_64(pmap_find_phys(kernel_pmap, (addr64_t)(*va + i * PAGE_SIZE)));
+		contiguous = contiguous && (i == 0 || pa[i] == pa[i - 1] + PAGE_SIZE);
+	}
+	uint64_t gva = sweet_gpu_vm_map(pa, npages, false);
+	printf("SWEET GPU: vm buffer %u pages (%s) pa[0] %llx pa[1] %llx -> GPU VA %llx\n", npages,
+	    contiguous ? "contiguous" : "scattered", pa[0], npages > 1 ? pa[1] : 0, gva);
+	return gva;
+}
+
+static void
+sample_test(vm_offset_t gpu, vm_offset_t smmu, vm_offset_t scratch_va, uint64_t scratch, bool vm)
+{
+	const uint32_t W = 128, H = 128, SW = 64, SH = 64;
+	vm_offset_t sva, dva;
+	uint64_t ks = kernel_page(&k_sample), src, dst;
+	if (vm) {
+		src = vm_buffer(&sva, SW * SH * 4);
+		dst = vm_buffer(&dva, W * H * 4);
+	} else {
+		src = gpu_page(&sva);
+		dst = gpu_alloc(&dva, W * H * 4);
+	}
+	if (src == 0 || dst == 0 || ks == 0) {
+		printf("SWEET GPU: sample: no pages\n");
+		return;
+	}
+	uint32_t *s = (uint32_t *)sva, *d = (uint32_t *)dva;
+	volatile uint32_t *fv = (volatile uint32_t *)(scratch_va + 56);
+	for (uint32_t y = 0; y < SH; y++) {
+		for (uint32_t x = 0; x < SW; x++) {
+			s[y * SW + x] = src_px(x, y);
+		}
+	}
+	for (uint32_t t = 0; t < 2; t++) {
+		for (uint32_t i = 0; i < W * H; i++) {
+			d[i] = 0xff000000u | ((i * 7) & 0xff) << 16 | ((i * 13) & 0xff) << 8 | (i & 0xff);
+		}
+		uint32_t orig_d0 = d[0];
+		flush_dcache64((addr64_t)sva, SW * SH * 4, FALSE);
+		flush_dcache64((addr64_t)dva, W * H * 4, FALSE);
+		/* floats as bits: 1.0 3f800000, 0.5 3f000000, 255.0 437f0000, -16.0 c1800000 */
+		uint32_t x0 = t == 0 ? 16 : 0, y0 = x0, w = t == 0 ? SW : W, h = t == 0 ? SH : H;
+		uint32_t consts[16] = {
+			t == 0 ? 0x3f800000u : 0x3f000000u, 0, 0, t == 0 ? 0x3f800000u : 0x3f000000u,
+			t == 0 ? 0xc1800000u : 0, t == 0 ? 0xc1800000u : 0, t == 0 ? 0x3f800000u : 0x3f000000u, 0x3f800000u,
+			0x437f0000u, 0x3f000000u, w - 1, W,
+			x0, y0, 0x3f800000u, 0x3f800000u,  /* source-over */
+		};
+		uint32_t tex[24], samp[8];
+		tex_rgba8(tex, src, SW, SH, SW * 4);
+		tex_rgba8(tex + 12, dst, W, H, W * 4);
+		samp_unnorm(samp, true);
+		samp_unnorm(samp + 4, false);
+		struct cs_extra x = {consts, 4, tex, samp, 2, h};
+		uint64_t bufs[1] = {dst};
+		uint32_t sizes[1] = {W * H * 4};
+		wr(smmu + 0x8000, 0x58, 0xffffffffu);
+		bool read = compute_run(gpu, &k_sample, ks, bufs, sizes, (w + 63) / 64, scratch + 56, 0x600 + t, &x);
+		delay(5000);
+		flush_dcache64((addr64_t)scratch, 64, TRUE);
+		flush_dcache64((addr64_t)dva, W * H * 4, FALSE);
+		uint32_t bad = 0, first = ~0u, maxdiff = 0, want_first = 0;
+		for (uint32_t py = 0; py < H; py++) {
+			for (uint32_t px = 0; px < W; px++) {
+				uint32_t i = py * W + px;
+				uint32_t dd = 0xff000000u | ((i * 7) & 0xff) << 16 | ((i * 13) & 0xff) << 8 | (i & 0xff);
+				uint32_t want;
+				if (t == 0) {
+					bool in = px >= x0 && px < x0 + w && py >= y0 && py < y0 + h;
+					want = in ? blend_ref(src_px(px - x0, py - y0), dd) : dd;
+				} else {
+					/* texel pairs and quarter weights along each axis, clamped */
+					int ax = (px & 1) ? (int)(px / 2) : (int)(px / 2) - 1, ay = (py & 1) ? (int)(py / 2) : (int)(py / 2) - 1;
+					uint32_t wx0 = (px & 1) ? 3 : 1, wy0 = (py & 1) ? 3 : 1;
+					int xs[2] = {ax < 0 ? 0 : ax, ax + 1 > (int)SW - 1 ? (int)SW - 1 : ax + 1};
+					int ys[2] = {ay < 0 ? 0 : ay, ay + 1 > (int)SH - 1 ? (int)SH - 1 : ay + 1};
+					uint32_t wxs[2] = {wx0, 4 - wx0}, wys[2] = {wy0, 4 - wy0}, sum[4] = {0, 0, 0, 0};
+					for (int j = 0; j < 2; j++) {
+						for (int k2 = 0; k2 < 2; k2++) {
+							uint32_t p = src_px((uint32_t)xs[k2], (uint32_t)ys[j]);
+							for (int c = 0; c < 4; c++) {
+								sum[c] += wys[j] * wxs[k2] * ((p >> (8 * c)) & 0xff);
+							}
+						}
+					}
+					want = 0;
+					for (int c = 0; c < 4; c++) {
+						uint32_t dc = (dd >> (8 * c)) & 0xff;
+						uint32_t v = (sum[c] * 255 + dc * (8160 - sum[3]) + 4080) / 8160;
+						want |= (v > 255 ? 255 : v) << (8 * c);
+					}
+				}
+				uint32_t got = d[i], md = 0;
+				for (int c = 0; c < 4; c++) {
+					int df = (int)((got >> (8 * c)) & 0xff) - (int)((want >> (8 * c)) & 0xff);
+					uint32_t a = (uint32_t)(df < 0 ? -df : df);
+					md = a > md ? a : md;
+				}
+				maxdiff = md > maxdiff ? md : maxdiff;
+				if (md > (t == 0 ? 1u : 2u) && bad++ == 0) {
+					first = i;
+					want_first = want;
+				}
+			}
+		}
+		cp_state(gpu, read ? "sample read:" : "sample NOT read (200 ms):");
+		smmu_faults(smmu, "after sample:");
+		printf("SWEET GPU: sample%s %s: fence %x (want %x), max channel diff %u, %u bad (first [%u] = %08x want %08x, "
+		    "d[0] %08x was %08x) -> %s\n", vm ? " (GPU VA)" : "", t == 0 ? "A identity 64x64 at (16,16)" : "B 2x upscale, opacity 0.5",
+		    *fv, 0x600 + t, maxdiff, bad, first, first < W * H ? d[first] : 0, want_first, d[0], orig_d0,
+		    bad == 0 ? "GPU TEXTURED QUAD MATCHES THE CPU" : "wrong");
+		if (!read) {
+			return;
+		}
+		gpu_wait(1);
+	}
+}
+
+/* Service mode (sweetgpu=8). */
+static bool g_ready;
+static vm_offset_t g_gpu, g_scratch_va;
+static uint64_t g_scratch, g_ksample4;
+static uint32_t g_seq = 0x10000;
+
+bool
+sweet_gpu_ready(void)
+{
+	return g_ready;
+}
+
+static uint32_t rb_free(void);
+
+int
+sweet_gpu_quad(const struct sweet_gpu_quad *q)
+{
+	if (!g_ready) {
+		return ENXIO;
+	}
+	static const uint32_t fmt_bpp[3] = {4, 1, 2}, fmt_code[3] = {TFMT5_8_8_8_8_UNORM, TFMT5_8_UNORM, TFMT5_8_8_UNORM};
+	uint32_t swiz = q->src_swiz;
+	bool swiz_ok = (swiz >> 12) == 0;
+	for (int c = 0; c < 4; c++) {
+		swiz_ok = swiz_ok && ((swiz >> (3 * c)) & 7) <= 5;
+	}
+	if (q->src_fmt > SWEET_GPU_FMT_RG8 || !swiz_ok || q->nedges > 4 ||
+	    q->src_w == 0 || q->src_h == 0 || q->src_w > 16384 || q->src_h > 16384 ||
+	    q->dst_w == 0 || q->dst_h == 0 || q->dst_w > 16384 || q->dst_h > 16384 ||
+	    q->src_pitch % 64 || q->dst_pitch % 64 || q->src_pitch < q->src_w * fmt_bpp[q->src_fmt] ||
+	    q->dst_pitch < q->dst_w * 4 ||
+	    (q->src_va & 63) || (q->dst_va & 63) || q->w == 0 || q->h == 0 ||
+	    q->x0 >= q->dst_w || q->y0 >= q->dst_h || q->w > q->dst_w - q->x0 || q->h > q->dst_h - q->y0 ||
+	    (q->flags & ~7u) || (q->flags & 6u) == 6u) {
+		return EINVAL;
+	}
+	uint64_t slen = (uint64_t)q->src_pitch * q->src_h, dlen = (uint64_t)q->dst_pitch * q->dst_h;
+	if (slen > 0xffffffffu || dlen > 0xffffffffu) {
+		return EINVAL;
+	}
+	lck_mtx_lock(&sweet_gpu_vm_lock);       /* keeps both mappings alive, serializes the ring */
+	int sf = vm_range(q->src_va, slen), df = vm_range(q->dst_va, dlen);
+	if (sf < 0 || df < 0 || g_maps[df].ro) {
+		lck_mtx_unlock(&sweet_gpu_vm_lock);
+		return EFAULT;
+	}
+	if (!g_ready) {                 /* went off while we waited for the lock */
+		lck_mtx_unlock(&sweet_gpu_vm_lock);
+		return ENXIO;
+	}
+	/* the dst rows the quad reads and writes */
+	uint64_t drow = q->dst_va + (uint64_t)q->y0 * q->dst_pitch, drows = (uint64_t)q->h * q->dst_pitch;
+	vm_cache((uint32_t)sf, q->src_va, slen);
+	vm_cache((uint32_t)df, drow, drows);
+	/* sample4.asm: 4 pixels per invocation from xa = x0 rounded down to 4 */
+	uint32_t xa = q->x0 & ~3u, groups = (q->x0 + q->w - xa + 3) / 4;
+	uint32_t consts[48] = {
+		q->m[0], q->m[1], q->m[2], q->m[3],
+		q->m[4], q->m[5], 0, 0x3f800000u,
+		0x437f0000u, 0x3f000000u, groups - 1, q->dst_pitch / 4,
+		xa, q->y0,
+		q->flags & (SWEET_GPU_QUAD_ADD | SWEET_GPU_QUAD_COPY) ? 0 : 0x3f800000u,        /* k0 */
+		q->flags & SWEET_GPU_QUAD_COPY ? 0xbf800000u : 0,                               /* k1 - 1 */
+		q->x0, q->x0 + q->w, 0xbf800000u, 0,
+		q->color[0], q->color[1], q->color[2], q->color[3],
+	};
+	for (uint32_t e = 0; e < 4; e++) {             /* c6-c9; unused edges pass everything */
+		consts[24 + 4 * e] = e < q->nedges ? q->edge[e][0] : 0;
+		consts[25 + 4 * e] = e < q->nedges ? q->edge[e][1] : 0;
+		consts[26 + 4 * e] = e < q->nedges ? q->edge[e][2] : 0x3f800000u;
+	}
+	consts[40] = 0x49800000u;                       /* K = 2^20 */
+	uint32_t tex[24], samp[8];
+	tex_desc(tex, q->src_va, q->src_w, q->src_h, q->src_pitch, fmt_code[q->src_fmt], swiz);
+	/* the whole pitch: groups at the right edge read (and keep) the padding */
+	tex_rgba8(tex + 12, q->dst_va, q->dst_pitch / 4, q->dst_h, q->dst_pitch);
+	samp_unnorm(samp, !(q->flags & SWEET_GPU_QUAD_NEAREST));
+	samp_unnorm(samp + 4, false);
+	struct cs_extra x = {consts, 12, tex, samp, 2, q->h};
+	uint64_t bufs[1] = {q->dst_va};
+	uint32_t sizes[1] = {(uint32_t)dlen};
+	uint64_t room_deadline;
+	clock_interval_to_deadline(500, NSEC_PER_MSEC, &room_deadline);
+	while (rb_free() < 512 && mach_absolute_time() < room_deadline) {
+		/* user submits queued ahead: compute_run emits ~200 dwords unchecked */
+	}
+	uint32_t seq = ++g_seq;
+	volatile uint32_t *fv = (volatile uint32_t *)(g_scratch_va + 64);
+	bool read = compute_run(g_gpu, &k_sample4, g_ksample4, bufs, sizes, (groups + 63) / 64, g_scratch + 64, seq, &x);
+	/*
+	 * Wait without the lock (user submits go on meanwhile): spin 0.5 ms
+	 * (delay() wakeups came ms late with the CPUs busy, 0140a), then poll
+	 * every 0.1 ms sleeping: a full-screen quad takes ~2 ms. The caller
+	 * keeps src and dst mapped.
+	 */
+	lck_mtx_unlock(&sweet_gpu_vm_lock);
+	bool done = false;
+	uint64_t deadline, spin_until;
+	clock_interval_to_deadline(500, NSEC_PER_MSEC, &deadline);
+	clock_interval_to_deadline(500, NSEC_PER_USEC, &spin_until);
+	while (read && !(done = (int32_t)(*fv - seq) >= 0) && mach_absolute_time() < deadline) {
+		if (mach_absolute_time() > spin_until) {
+			delay(100);
+		}
+		flush_dcache64((addr64_t)g_scratch + 64, 4, TRUE);
+	}
+	lck_mtx_lock(&sweet_gpu_vm_lock);
+	df = vm_range(q->dst_va, dlen);
+	if (df >= 0) {
+		vm_cache((uint32_t)df, drow, drows);
+	}
+	if (!done) {
+		g_ready = false;        /* hung: no recovery yet, fail fast from now on */
+		cp_state(g_gpu, "quad timeout:");
+		smmu_faults(g_smmu, "quad timeout:");
+		printf("SWEET GPU: quad timed out, GPU service off until reboot\n");
+	}
+	lck_mtx_unlock(&sweet_gpu_vm_lock);
+	return done ? 0 : ETIMEDOUT;
+}
+
+/*
+ * User command streams (sweet_gpu.h): IBs into the ring without waiting,
+ * fence page written by the CP. The ring is shared with sweet_gpu_quad
+ * (both under the VM lock); quads wait for the CP to read everything, user
+ * submits only for room (the CP reads past an IB once it has parsed it).
+ */
+static vm_offset_t g_fence_va;
+static uint64_t g_fence_pa;
+static uint32_t g_submit_seq;           /* last submitted */
+static uint32_t g_fence_seen;           /* fence value at g_fence_when */
+static uint64_t g_fence_when;
+static int g_max_mhz = 300;
+
+#define CP_INDIRECT_BUFFER_PFE  0x3f
+
+/* Ring dwords free (one slot stays empty: rptr == wptr means empty). */
+static uint32_t
+rb_free(void)
+{
+	return (gr(g_gpu, R_CP_RB_RPTR) - rb_n - 1) & (RB_DWORDS - 1);
+}
+
+static uint32_t
+fence_now(void)
+{
+	flush_dcache64((addr64_t)g_fence_pa, 64, TRUE);
+	return *(volatile uint32_t *)g_fence_va;
+}
+
+/* VM lock held: declare the GPU hung. */
+static void
+gpu_hung(const char *why)
+{
+	g_ready = false;
+	cp_state(g_gpu, why);
+	smmu_faults(g_smmu, why);
+	printf("SWEET GPU: %s: fence %u, submitted %u: GPU service off until reboot\n", why,
+	    fence_now(), g_submit_seq);
+}
+
+/* VM lock held: log (rate-limited) and clear a recorded SMMU fault, with the mapping below it. */
+static void
+smmu_report(void)
+{
+	static uint32_t logged;
+	vm_offset_t cb = g_smmu + 0x8000;
+	uint32_t fsr = rd(cb, 0x58);
+	if ((fsr & ~0x600u) == 0) {     /* bits 9-10: descriptor format only */
+		return;
+	}
+	uint64_t far = ((uint64_t)rd(cb, 0x64) << 32) | rd(cb, 0x60);
+	if (logged < 32) {
+		logged++;
+		int64_t below = -1;
+		if (far >= GVA_BASE && far - GVA_BASE < (uint64_t)GVA_PAGES * PAGE_SIZE && g_owner != NULL) {
+			for (int64_t p = (int64_t)((far - GVA_BASE) / PAGE_SIZE); p >= 0 && below < 0; p--) {
+				uint32_t m = g_owner[p];
+				if (m != 0 && m != VM_GUARD) {
+					below = m;
+				}
+			}
+		}
+		printf("SWEET GPU: SMMU fault (non-fatal) FSR %08x FAR %llx FSYNR0 %08x; mapping below: %llx + %llx\n",
+		    fsr, far, rd(cb, 0x68), below >= 0 ? g_maps[below].va : 0,
+		    below >= 0 ? (uint64_t)g_maps[below].npages * PAGE_SIZE : 0);
+	}
+	wr(cb, 0x58, fsr);      /* write-1-to-clear */
+}
+
+int
+sweet_gpu_submit(const struct sweet_gpu_ib *ib, uint32_t n, uint32_t *seqno)
+{
+	if (!g_ready || g_fence_va == 0) {
+		return ENXIO;
+	}
+	if (n == 0 || n > SWEET_GPU_MAX_IBS) {
+		return EINVAL;
+	}
+	lck_mtx_lock(&sweet_gpu_vm_lock);
+	int ret = 0;
+	for (uint32_t i = 0; i < n && ret == 0; i++) {
+		if (ib[i].dwords == 0 || ib[i].dwords > 0xfffffu || (ib[i].iova & 3)) {
+			ret = EINVAL;
+		} else if (vm_range(ib[i].iova, (uint64_t)ib[i].dwords * 4) < 0) {
+			ret = EFAULT;
+		}
+	}
+	smmu_report();
+	uint32_t need = 4 * n + 6 + 5;
+	uint64_t deadline;
+	clock_interval_to_deadline(500, NSEC_PER_MSEC, &deadline);
+	while (ret == 0 && g_ready && rb_free() < need) {
+		if (mach_absolute_time() > deadline) {
+			gpu_hung("submit: ring full");
+			ret = ETIMEDOUT;
+		}
+	}
+	if (ret == 0 && !g_ready) {
+		ret = ENXIO;
+	}
+	if (ret == 0) {
+		for (uint32_t i = 0; i < n; i++) {
+			emit(pkt7(CP_INDIRECT_BUFFER_PFE, 3));
+			emit((uint32_t)ib[i].iova);
+			emit((uint32_t)(ib[i].iova >> 32));
+			emit(ib[i].dwords);
+		}
+		emit(pkt7(CP_SET_RENDER_MODE, 5)); emit(0); emit(0); emit(0); emit(0); emit(0);
+		uint32_t seq = ++g_submit_seq;
+		emit(pkt7(CP_EVENT_WRITE, 4)); emit(CACHE_FLUSH_TS);
+		emit((uint32_t)g_fence_pa); emit((uint32_t)(g_fence_pa >> 32)); emit(seq);
+		flush_dcache64((addr64_t)rb_pa, PAGE_SIZE, TRUE);
+		gw(g_gpu, R_CP_RB_WPTR, rb_n);
+		*seqno = seq;
+	}
+	lck_mtx_unlock(&sweet_gpu_vm_lock);
+	return ret;
+}
+
+int
+sweet_gpu_wait(uint32_t seqno, uint32_t timeout_ms)
+{
+	if (g_fence_va == 0) {
+		return ENXIO;
+	}
+	uint64_t deadline, spin_until;
+	clock_interval_to_deadline(timeout_ms, NSEC_PER_MSEC, &deadline);
+	clock_interval_to_deadline(2, NSEC_PER_MSEC, &spin_until);
+	for (;;) {
+		uint32_t f = fence_now();
+		if ((int32_t)(f - seqno) >= 0) {
+			return 0;
+		}
+		if (!g_ready) {
+			return ENXIO;
+		}
+		uint64_t now = mach_absolute_time();
+		lck_mtx_lock(&sweet_gpu_vm_lock);
+		if (f != g_fence_seen || g_fence_when == 0) {
+			g_fence_seen = f;
+			g_fence_when = now;
+		} else if (g_ready && f != g_submit_seq && usecs(now - g_fence_when) > 2000000) {
+			gpu_hung("wait: fence stuck 2 s");
+		}
+		lck_mtx_unlock(&sweet_gpu_vm_lock);
+		if (now > deadline) {
+			return ETIMEDOUT;
+		}
+		if (now > spin_until) {
+			delay(200);     /* past 2 ms, poll every ~0.2 ms without holding a CPU */
+		}
+	}
+}
+
+void
+sweet_gpu_set_fence_page(uintptr_t kva, uint64_t pa)
+{
+	g_fence_pa = pa;
+	g_fence_va = (vm_offset_t)kva;
+}
