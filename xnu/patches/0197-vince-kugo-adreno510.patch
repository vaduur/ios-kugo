+
+/*
+ * sweetgpuclk=400: the 401.8 MHz corner; 600: GPLL0 undivided, inside the
+ * 624 MHz corner (MSM8996 Pro max; 600 is the closest GPLL0 rate, mmpll9
+ * stays untouched). GFX rail (PMI8994 S2) first to that corner's ceiling
+ * voltage (downstream msm8996 gfx_cpr qcom,cpr-voltage-ceiling: 825 mV at
+ * 401.8, 1015 mV at 624; open loop, no CPR), above 510 MHz VDD_MX to super
+ * turbo over the RPM, read back, then gfx3d = GPLL0 / 1.5 (field 2) or / 1
+ * (field 1). mem-acc is already in its high-voltage setting (0 at boot,
+ * corner-acc-map <1 0>). VM lock held: no quad runs meanwhile.
+ */
+extern bool sweet_rpm_mx_corner(uint32_t corner);
+
+static bool
+gfx_raise(int mhz)
+{
+#if defined(KUGO)
+	(void)mhz;
+	return false;   /* not yet: needs the CPR corner for >266 MHz */
+#endif
+	uint8_t sub = 0, v = 0;
+	uint32_t mv = mhz == 600 ? 1015 : 825;
+	if (!sweet_pmic_read(GFX_S2, 0x05, &sub) || (sub != 8 && sub != 9)) {
+		return false;
+	}
+	if (mhz == 600 && !sweet_rpm_mx_corner(7)) {
+		return false;
+	}
+	uint8_t vset = (uint8_t)((mv - (sub == 9 ? 80 : 0)) / 5);
+	if (!sweet_pmic_write(GFX_S2, 0x41, vset)) {
+		return false;
+	}
+	delay(4000);                    /* slew up to 270 mV, then settle */
+	if (!sweet_pmic_read(GFX_S2, 0x41, &v) || v != vset) {
+		printf("SWEET GPU: S2 vset %u, want %u: clock stays\n", v, vset);
+		return false;
+	}
+	return gfx_clock(mhz == 600 ? 1 : 2);
+}
