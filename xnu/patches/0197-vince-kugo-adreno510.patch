+static int gpu_chan;
+static vm_offset_t mmcc;        /* MMSS clock controller, for the gfx3d clock */
+
+static void
+gpu_sleep(unsigned secs)
+{
+	uint64_t deadline;
+	clock_interval_to_deadline(secs, NSEC_PER_SEC, &deadline);
+	(void)assert_wait_deadline(&gpu_chan, THREAD_UNINT, deadline);
+	thread_block(THREAD_CONTINUE_NULL);
+}
+
+static int g_level;     /* the sweetgpu boot-arg */
+
+/*
+ * Pauses between bring-up stages (11 s: a hang or panic shows which stage
+ * it was). Service mode (sweetgpu=8) skips them: backboardd waits for it.
+ */
+static void
+gpu_wait(unsigned secs)
+{
+	if (g_level >= 8 && secs > 2) {
+		return;
+	}
+	gpu_sleep(secs);
+}
+
+static uint32_t
+rd(vm_offset_t base, uint32_t off)
+{
+	uint32_t v = *(volatile uint32_t *)(base + off);
+	__asm__ volatile("dmb sy" ::: "memory");
+	return v;
+}
+
+/*
+ * The value always goes through a real register ("r", never wzr): firmware
+ * traps and emulates some SMMU writes (S2CR), and a trapped `str wzr`
+ * stalled the CPU (0121a-0123a).
+ */
+static void
+wr(vm_offset_t base, uint32_t off, uint32_t v)
+{
+	__asm__ volatile("dmb sy\n\tstr %w0, [%1]\n\tdsb sy" : : "r"(v), "r"(base + off) : "memory");
+}
+
+/* Poll until (reg & mask) == want, up to ms milliseconds. */
+static bool
+poll(vm_offset_t base, uint32_t off, uint32_t mask, uint32_t want, unsigned ms)
+{
+	for (unsigned i = 0; i < ms * 10; i++) {
+		if ((rd(base, off) & mask) == want) {
+			return true;
+		}
+		delay(100);
+	}
+	return false;
+}
+
+/* gcc / gcc46: the GCC pages at 0x309000 and 0x346000. */
+static void
+dump(vm_offset_t mm, vm_offset_t gcc, vm_offset_t gcc46, const char *when)
+{
+	printf("SWEET GPU: %s mmcc gpu_gdsc %08x gx_gdsc %08x clamp %08x ahb %08x gfx3d_br %08x "
+	    "gfx3d_rcg %08x/%08x rbbm_rcg %08x/%08x rbbm_br %08x gcc mmss_bimc_gfx %08x bimc_gfx %08x\n",
+	    when, rd(mm, 0x4034), rd(mm, 0x4024), rd(mm, 0x4300), rd(mm, 0x403c), rd(mm, 0x4028),
+	    rd(mm, 0x4000), rd(mm, 0x4004), rd(mm, 0x4090), rd(mm, 0x4094), rd(mm, 0x40b0),
+	    rd(gcc, 0x10), rd(gcc46, 0x18));
+}
+
+/* Branch enable + wait for CLK_OFF (bit 31) to clear. */
+static bool
+branch_on(vm_offset_t base, uint32_t off)
+{
+	wr(base, off, rd(base, off) | 1u);
+	return poll(base, off, 1u << 31, 0, 10);
+}
+
+/* GDSC on: clear SW_COLLAPSE, wait for PWR_ON (bit 31). */
+static bool
+gdsc_on(vm_offset_t mm, uint32_t gdscr)
+{
+	wr(mm, gdscr, rd(mm, gdscr) & ~1u);
+	return poll(mm, gdscr, 1u << 31, 1u << 31, 10);
+}
+
+static uint32_t
+parity(uint32_t v)
+{
+	return (0x9669u >> (0xfu & (v ^ (v >> 4) ^ (v >> 8) ^ (v >> 12) ^ (v >> 16) ^
+	       (v >> 20) ^ (v >> 24) ^ (v >> 28)))) & 1u;
+}
+
+/* msm_ringbuffer OUT_PKT7 header */
+static uint32_t
+pkt7(uint32_t op, uint32_t cnt)
+{
+	return (7u << 28) | cnt | (parity(cnt) << 15) | ((op & 0x7fu) << 16) | (parity(op) << 23);
+}
+
+static uint32_t
+pkt4(uint32_t reg, uint32_t cnt)
+{
+	return (4u << 28) | cnt | (parity(cnt) << 7) | ((reg & 0x3ffffu) << 8) | (parity(reg) << 27);
+}
+
+/* The ring: one 16 KB page (4096 dwords), wraps; rb_n is the next slot. */
+#define RB_DWORDS       4096u
+static uint32_t *rb, rb_n;
+static uint64_t rb_pa;
+
+static void
+emit(uint32_t v)
+{
+	rb[rb_n] = v;
+	rb_n = (rb_n + 1) & (RB_DWORDS - 1);
+}
+
+static void
+gw(vm_offset_t gpu, uint32_t reg, uint32_t v)
+{
+	wr(gpu, reg * 4, v);
+}
+
+static uint32_t
+gr(vm_offset_t gpu, uint32_t reg)
+{
+	return rd(gpu, reg * 4);
+}
+
+static void
+gw64(vm_offset_t gpu, uint32_t reg, uint64_t v)
+{
+	gw(gpu, reg, (uint32_t)v);
+	gw(gpu, reg + 1, (uint32_t)(v >> 32));
+}
+
+/* Physically contiguous, zeroed kernel memory; returns its PA (0 on failure). */
+static uint64_t
+gpu_alloc(vm_offset_t *va, vm_size_t size)
+{
+	if (kmem_alloc_contig(kernel_map, va, size, PAGE_MASK, 0, 0,
+	    KMA_DATA | KMA_ZERO | KMA_PERMANENT, VM_KERN_MEMORY_IOKIT) != KERN_SUCCESS) {
+		return 0;
+	}
+	return ptoa_64(pmap_find_phys(kernel_pmap, (addr64_t)*va));
+}
+
+/* One 16 KB page. */
+static uint64_t
+gpu_page(vm_offset_t *va)
+{
+	return gpu_alloc(va, PAGE_SIZE);
+}
+
+static bool
+blob(const char *name, uint64_t *pa, uint32_t *len)
+{
+	DTEntry node;
+	uint64_t const *v;
+	unsigned int size;
+	if (SecureDTLookupEntry(NULL, "/chosen/memory-map", &node) != kSuccess ||
+	    SecureDTGetProperty(node, name, (void const **)&v, &size) != kSuccess || size != 16) {
+		return false;
+	}
+	*pa = v[0];
+	*len = (uint32_t)v[1];
+	return true;
+}
