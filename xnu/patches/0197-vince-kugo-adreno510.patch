+
+/* Full-screen (750x1334, pitch 3072) source-over quads: average us of 5. */
+static uint64_t
+quad_bench(void)
+{
+	static vm_offset_t va[2];
+	static uint64_t gva[2];
+	const uint32_t pitch = 3072, h = 1334, bytes = (pitch * h + PAGE_MASK) & ~PAGE_MASK;
+	for (int b = 0; b < 2 && gva[1] == 0; b++) {
+		uint64_t pa = gpu_alloc(&va[b], bytes), pages[(3072 * 1334 + PAGE_MASK) / PAGE_SIZE];
+		if (pa == 0) {
+			return 0;
+		}
+		for (uint32_t i = 0; i < bytes / PAGE_SIZE; i++) {
+			pages[i] = pa + (uint64_t)i * PAGE_SIZE;
+		}
+		gva[b] = sweet_gpu_vm_map(pages, bytes / PAGE_SIZE, false);
+		uint32_t *p = (uint32_t *)va[b];
+		for (uint32_t i = 0; i < pitch / 4 * h; i++) {
+			p[i] = b ? 0xff000000u | (i * 0x10305u) : src_px(i % 768, i / 768);
+		}
+	}
+	if (gva[0] == 0 || gva[1] == 0) {
+		return 0;
+	}
+	struct sweet_gpu_quad q = {
+		.src_va = gva[0], .dst_va = gva[1],
+		.src_w = 750, .src_h = h, .src_pitch = pitch,
+		.dst_w = 750, .dst_h = h, .dst_pitch = pitch,
+		.w = 750, .h = h,
+		.m = {0x3f800000u, 0, 0, 0x3f800000u, 0, 0},
+		.color = {0x3f800000u, 0x3f800000u, 0x3f800000u, 0x3f800000u}, .src_swiz = SWIZ_XYZW,
+	};
+	uint64_t t0 = mach_absolute_time();
+	for (int i = 0; i < 5; i++) {
+		if (sweet_gpu_quad(&q) != 0) {
+			return 0;
+		}
+	}
+	return usecs(mach_absolute_time() - t0) / 5;
+}
+
+/* sweet_gpu_quad once, on scattered kernel buffers (sample_test A through the API). */
+static void
+api_selftest(void)
+{
+	vm_offset_t sva, dva;
+	uint64_t src = vm_buffer(&sva, 64 * 64 * 4), dst = vm_buffer(&dva, 128 * 128 * 4);
+	if (src == 0 || dst == 0) {
+		printf("SWEET GPU: api selftest: no buffers\n");
+		return;
+	}
+	uint32_t *s = (uint32_t *)sva, *d = (uint32_t *)dva;
+	for (uint32_t i = 0; i < 64 * 64; i++) {
+		s[i] = src_px(i % 64, i / 64);
+	}
+	struct sweet_gpu_quad q = {
+		.src_va = src, .dst_va = dst,
+		.src_w = 64, .src_h = 64, .src_pitch = 256,
+		.dst_w = 128, .dst_h = 128, .dst_pitch = 512,
+		.y0 = 16, .h = 64,
+		.m = {0x3f800000u, 0, 0, 0x3f800000u, 0, 0xc1800000u},
+		.color = {0x3f800000u, 0x3f800000u, 0x3f800000u, 0x3f800000u}, .src_swiz = SWIZ_XYZW,
+	};
+	/* source-over at x0 16 (4-aligned), source-over and copy at x0 13, w 61 */
+	static const struct { uint32_t x0, w, tx, flags; } t[3] = {
+		{16, 64, 0xc1800000u, 0}, {13, 61, 0xc1500000u, 0}, {13, 61, 0xc1500000u, SWEET_GPU_QUAD_COPY},
+	};
+	int r = 0;
+	uint32_t bad = 0;
+	uint64_t t0 = 0, t1 = 0;
+	for (int k = 0; k < 3; k++) {
+		for (uint32_t i = 0; i < 128 * 128; i++) {
+			d[i] = 0xff000000u | ((i * 7) & 0xff) << 16 | ((i * 13) & 0xff) << 8 | (i & 0xff);
+		}
+		q.x0 = t[k].x0, q.w = t[k].w, q.m[4] = t[k].tx, q.flags = t[k].flags;
+		uint64_t a0 = mach_absolute_time();
+		int rk = sweet_gpu_quad(&q);
+		if (k == 0) {
+			t0 = a0, t1 = mach_absolute_time();
+		}
+		r = r ? r : rk;
+		for (uint32_t i = 0; i < 128 * 128; i++) {
+			uint32_t px = i % 128, py = i / 128;
+			uint32_t dd = 0xff000000u | ((i * 7) & 0xff) << 16 | ((i * 13) & 0xff) << 8 | (i & 0xff);
+			bool in = px >= t[k].x0 && px < t[k].x0 + t[k].w && py >= 16 && py < 80;
+			uint32_t sp = in ? src_px(px - t[k].x0, py - 16) : 0;
+			uint32_t want = !in ? dd : t[k].flags ? sp : blend_ref(sp, dd);
+			for (int c = 0; c < 32; c += 8) {
+				int df = (int)((d[i] >> c) & 0xff) - (int)((want >> c) & 0xff);
+				if (df > 1 || df < -1) {
+					bad++;
+					break;
+				}
+			}
+		}
+	}
+	/* rejected: rect past the dst edge, unmapped src */
+	struct sweet_gpu_quad e1 = q, e2 = q;
+	e1.x0 = 100;
+	e2.src_va = 0x3ff000000ull;
+	int r1 = sweet_gpu_quad(&e1), r2 = sweet_gpu_quad(&e2);
+	printf("SWEET GPU: api selftest: sweet_gpu_quad -> %d in %llu us, %u bad pixels; bad rect -> %d, unmapped -> %d -> %s\n",
+	    r, usecs(t1 - t0), bad, r1, r2, r == 0 && bad == 0 && r1 == EINVAL && r2 == EFAULT ? "API OK" : "API WRONG");
+}
+
+/* Step 4.1: fill.asm and blend.asm, checked by the CPU. */
+static void
+compute_test(vm_offset_t gpu, vm_offset_t smmu, vm_offset_t scratch_va, uint64_t scratch)
+{
+	const uint32_t groups = 16, n = 64 * groups, bytes = n * 4;
+	vm_offset_t ava, bva, wva;
+	uint64_t a = gpu_page(&ava), b = gpu_page(&bva), w = gpu_page(&wva);
+	uint64_t kfill = kernel_page(&k_fill), kblend = kernel_page(&k_blend);
+	if (a == 0 || b == 0 || w == 0 || kfill == 0 || kblend == 0 || bytes > PAGE_SIZE) {
+		printf("SWEET GPU: no compute pages\n");
+		return;
+	}
+	uint32_t *pa_ = (uint32_t *)ava, *pb = (uint32_t *)bva, *want = (uint32_t *)wva;
+	volatile uint32_t *fv = (volatile uint32_t *)(scratch_va + 32);
+
+	for (uint32_t t = 0; t < 2; t++) {
+		if (t == 0) {
+			memset(pa_, 0xee, bytes);
+		} else {
+			for (uint32_t i = 0; i < n; i++) {
+				/* premultiplied source: every channel <= alpha */
+				uint32_t al = (i * 37) & 0xff, c = al ? (i * 11) % (al + 1) : 0;
+				pa_[i] = (al << 24) | (c << 16) | ((c / 2) << 8) | (c / 3);
+				pb[i] = 0xff000000u | ((i * 7) & 0xff) << 16 | ((i * 13) & 0xff) << 8 | (i & 0xff);
+				want[i] = blend_ref(pa_[i], pb[i]);
+			}
+		}
+		flush_dcache64((addr64_t)a, PAGE_SIZE, TRUE);
+		flush_dcache64((addr64_t)b, PAGE_SIZE, TRUE);
+		wr(smmu + 0x8000, 0x58, 0xffffffffu);
+		uint64_t bufs[2] = {a, b};
+		uint32_t sizes[2] = {bytes, bytes};
+		bool read = compute_run(gpu, t == 0 ? &k_fill : &k_blend, t == 0 ? kfill : kblend,
+		    bufs, sizes, groups, scratch + 32, 0x400 + t, NULL);
+		delay(5000);
+		flush_dcache64((addr64_t)scratch, 64, TRUE);
+		flush_dcache64((addr64_t)a, PAGE_SIZE, TRUE);
+		flush_dcache64((addr64_t)b, PAGE_SIZE, TRUE);
+		const uint32_t *o = t == 0 ? pa_ : pb;
+		uint32_t bad = 0, first = ~0u;
+		for (uint32_t i = 0; i < n; i++) {
+			uint32_t w = t == 0 ? (i ^ 0x5a5a0000u) : want[i];
+			if (o[i] != w && bad++ == 0) {
+				first = i;
+			}
+		}
+		cp_state(gpu, read ? "compute read:" : "compute NOT read (200 ms):");
+		smmu_faults(smmu, "after compute:");
+		printf("SWEET GPU: compute %s, %u pixels: fence %x (want %x), %u wrong (first [%u] = %08x want %08x); "
+		    "out[1..3] %08x %08x %08x -> %s\n", t == 0 ? "fill" : "blend (premultiplied source-over)", n,
+		    *fv, 0x400 + t, bad, first, first < n ? o[first] : 0,
+		    first < n ? (t == 0 ? first ^ 0x5a5a0000u : want[first]) : 0, o[1], o[2], o[3],
+		    bad == 0 ? (t == 0 ? "GPU SHADER WORKS" : "GPU BLEND MATCHES THE CPU") : "wrong");
+		if (!read) {
+			return;
+		}
+		gpu_wait(1);
+	}
+}
+
+/* Step 2: command processor. */
+static void
+cp_test(vm_offset_t gpu, int level)
+{
+	uint64_t pm4, pfp;
+	uint32_t pm4_len, pfp_len;
+	if (!blob("GPU-PM4", &pm4, &pm4_len) || !blob("GPU-PFP", &pfp, &pfp_len)) {
+		printf("SWEET GPU: no GPU-PM4/GPU-PFP in the payload, no CP test\n");
+		return;
+	}
+	vm_offset_t smmu = ml_io_map(SMMU_PA, 0x10000);
+	if (smmu == 0) {
+		return;
+	}
+	g_smmu = smmu;
+	printf("SWEET GPU: SMMU sCR0 %08x IDR0 %08x IDR1 %08x SMR0 %08x S2CR0 %08x CB0 SCTLR %08x\n",
+	    rd(smmu, 0), rd(smmu, 0x20), rd(smmu, 0x24), rd(smmu, 0x800), rd(smmu, 0xc00), rd(smmu, 0x8000));
+	if (!smmu_identity(smmu)) {
+		printf("SWEET GPU: no GPU memory access without the SMMU set up, stop\n");
+		return;
+	}
+	vm_offset_t ring_va, scratch_va;
+	uint64_t scratch = gpu_page(&scratch_va);
+	rb_pa = gpu_page(&ring_va);
+	if (rb_pa == 0 || scratch == 0) {
+		printf("SWEET GPU: no ring/scratch page\n");
+		return;
+	}
+	rb = (uint32_t *)ring_va;
+	printf("SWEET GPU: pm4 %llx (%u) pfp %llx (%u) ring %llx scratch %llx\n",
+	    pm4, pm4_len, pfp, pfp_len, rb_pa, scratch);
+	flush_dcache64((addr64_t)pm4, pm4_len, TRUE);
+	flush_dcache64((addr64_t)pfp, pfp_len, TRUE);
+	gpu_wait(11);
+
+	/*
+	 * a5xx_pm_resume (A530): power the RB/CCU and SP islands; without them
+	 * the CP hung on the first 2D blit (0126a, RBBM_STATUS c00001c3).
+	 */
+#if defined(KUGO)
+	g_gpu_regs = gpu;
+	/* A510: no GPMU islands (mainline a5xx_pm_resume returns early) */
+	bool rbccu = true, sp = true;
+	if (0) {
+#else
+	bool rbccu, sp;
+	{
+#endif
+	gw(gpu, R_GPMU_RBCCU_POWER_CNTL, 0x778000);
+	rbccu = poll(gpu, R_GPMU_RBCCU_PWR_CLK_STATUS * 4, 1u << 20, 1u << 20, 1);
+	gw(gpu, R_GPMU_SP_POWER_CNTL, 0x778000);
+	sp = poll(gpu, R_GPMU_SP_PWR_CLK_STATUS * 4, 1u << 20, 1u << 20, 1);
+	}
+	printf("SWEET GPU: RBCCU power %s (%08x), SP power %s (%08x)\n", rbccu ? "on" : "TIMEOUT",
+	    gr(gpu, R_GPMU_RBCCU_PWR_CLK_STATUS), sp ? "on" : "TIMEOUT", gr(gpu, R_GPMU_SP_PWR_CLK_STATUS));
+
+	/* Subset of a5xx_hw_init (A530 values; HWCG, GPMU firmware, CP_PROTECT left out). */
+	gw(gpu, R_VBIF_RR_QOS_ARB, 3);
+	gw(gpu, R_RBBM_PERFCTR_GPU_BUSY_MASKED, 0xffffffff);
+	gw(gpu, R_RBBM_AHB_CNTL0, 1);
+	gw(gpu, R_UCHE_CACHE_WAYS, 2);
+	gw64(gpu, R_UCHE_TRAP_BASE, 0x0001ffffffff0000ull);
+	gw64(gpu, R_UCHE_WRITE_THRU_BASE, 0x0001ffffffff0000ull);
+	gw64(gpu, R_UCHE_GMEM_RANGE_MIN, 0x00100000);
+#if defined(KUGO)
+	gw64(gpu, R_UCHE_GMEM_RANGE_MAX, 0x00100000 + 0x40000 - 1);    /* A510: 256 KB GMEM */
+	gw(gpu, R_CP_MEQ_THRESHOLDS, 0x20);
+	gw(gpu, R_CP_MERCIU_SIZE, 0x20);
+	gw(gpu, R_CP_ROQ_THRESHOLDS_2, 0x40000030);
+	gw(gpu, R_CP_ROQ_THRESHOLDS_1, 0x20100d0a);
+	gw(gpu, R_PC_DBG_ECO_CNTL, (0x200u << 11) | (0x200u << 22));
+	gw(gpu, R_RB_DBG_ECO_CNTL, gr(gpu, R_RB_DBG_ECO_CNTL) & ~(1u << 11));   /* CCU fix on newer A510s */
+#else
+	gw64(gpu, R_UCHE_GMEM_RANGE_MAX, 0x00100000 + 0x100000 - 1);   /* 1 MB GMEM */
+	gw(gpu, R_CP_MEQ_THRESHOLDS, 0x40);
+	gw(gpu, R_CP_MERCIU_SIZE, 0x40);
+	gw(gpu, R_CP_ROQ_THRESHOLDS_2, 0x80000060);
+	gw(gpu, R_CP_ROQ_THRESHOLDS_1, 0x40201b16);
+	gw(gpu, R_PC_DBG_ECO_CNTL, (0x400u << 11) | (0x300u << 22));
+#endif
+	gw(gpu, R_UCHE_MODE_CNTL, 1u << 29);
+	gw(gpu, R_CP_CHICKEN_DBG, 0x02000000);
+	gw(gpu, R_RBBM_AHB_CNTL1, 0xa6ffffff);
+	gw(gpu, R_RBBM_AHB_CNTL2, 0x3f);
+#if defined(KUGO)
+	gw(gpu, R_TPL1_MODE_CNTL, 1u << 7);     /* highest bank bit 14 (live DT) */
+	gw(gpu, R_RB_MODE_CNTL, 1u << 1);
+#else
+	gw(gpu, R_TPL1_MODE_CNTL, 2u << 7);     /* highest bank bit 15 */
+	gw(gpu, R_RB_MODE_CNTL, 2u << 1);
+#endif
+	gw(gpu, R_VPC_DBG_ECO_CNTL, gr(gpu, R_VPC_DBG_ECO_CNTL) | (1u << 10));
+	gw(gpu, R_SECVID_TSB_CNTL, 0);
+	gw64(gpu, R_SECVID_TSB_BASE, 0);
+	gw(gpu, R_SECVID_TSB_SIZE, 0);
+	/*
+	 * Every block in 64-bit mode (the CP alone was not enough: the 0127a
+	 * blit faulted at the source PA's low 32 bits).
+	 */
+	static const uint16_t addr_mode[] = {
+		0x0860 /* CP */, 0x0bc1 /* VSC */, 0x0c81 /* GRAS */, 0x0cc5 /* RB */, 0x0d01 /* PC */,
+		0x0e05 /* HLSQ */, 0x0e41 /* VFD */, 0x0e61 /* VPC */, 0x0e80 /* UCHE */, 0x0ec1 /* SP */,
+		0x0f01 /* TPL1 */, R_SECVID_TSB_ADDR_MODE,
+	};
+	for (unsigned i = 0; i < sizeof(addr_mode) / sizeof(addr_mode[0]); i++) {
+		gw(gpu, addr_mode[i], 1);
+	}
+	gw64(gpu, R_CP_ME_INSTR_BASE, pm4);
+	gw64(gpu, R_CP_PFP_INSTR_BASE, pfp);
+	gw64(gpu, R_CP_RB_BASE, rb_pa);
+	/* BUFSZ log2(16 KB / 8) = 11, BLKSZ log2(32 / 8) = 2 (mainline), NO_UPDATE */
+	gw(gpu, R_CP_RB_CNTL, 11u | (2u << 8) | (1u << 27));
+	cp_state(gpu, "before ME start:");
+
+	rb_n = 0;
+	emit(pkt7(CP_ME_INIT, 8));
+	emit(0x2f);
+	emit(0x3);
+	emit(0x20000000);
+	emit(0);
+	emit(0);
+#if defined(KUGO)
+	emit(0x1);              /* A510 token and syncs workaround (mainline a5xx_me_init) */
+#else
+	emit(0xb);              /* A530 token-end-sync workaround */
+#endif
+	emit(0);
+	emit(0);
+	emit(pkt7(CP_MEM_WRITE, 3));
+	emit((uint32_t)scratch);
+	emit((uint32_t)(scratch >> 32));
+	emit(0xc0ffee01);
+	emit(pkt7(CP_NOP, 0));
+	flush_dcache64((addr64_t)scratch, PAGE_SIZE, TRUE);
+
+	gw(gpu, R_CP_PFP_ME_CNTL, 0);   /* clear ME_HALT */
+	bool read = kick(gpu);
+	delay(1000);
+	flush_dcache64((addr64_t)scratch, 64, TRUE);
+	uint32_t got = *(volatile uint32_t *)scratch_va;
+	cp_state(gpu, read ? "ring consumed:" : "ring NOT consumed (200 ms):");
+	smmu_faults(smmu, "after ring:");
+	printf("SWEET GPU: scratch %08x -> %s\n", got,
+	    got == 0xc0ffee01 ? "CP_MEM_WRITE landed: COMMAND PROCESSOR WORKS" : "no write");
+	if (level >= 3 && read && got == 0xc0ffee01) {
+		/* Leave secure mode (see the header). */
+		gpu_wait(11);
+		if (!zap_load()) {
+			printf("SWEET GPU: no zap shader, the GPU stays secure: no blit test\n");
+			return;
+		}
+		gpu_wait(2);
+#if !defined(KUGO)
+		emit(pkt7(CP_SET_SECURE_MODE, 1));
+		emit(0);
+#endif
+		emit(pkt7(CP_MEM_WRITE, 3));
+		emit((uint32_t)scratch + 8);
+		emit((uint32_t)(scratch >> 32));
+		emit(0x5ec0de00);
+		read = kick(gpu);
+		delay(1000);
+		flush_dcache64((addr64_t)scratch, 64, TRUE);
+		cp_state(gpu, read ? "after CP_SET_SECURE_MODE 0:" : "CP_SET_SECURE_MODE 0 NOT read:");
+		smmu_faults(smmu, "after CP_SET_SECURE_MODE 0:");
+		printf("SWEET GPU: marker after secure-mode packet %08x (want 5ec0de00)\n",
+		    *(volatile uint32_t *)(scratch_va + 8));
+		gpu_wait(2);
+		if (level >= 8) {
+			(void)gfx_clock(3);     /* 300 MHz */
+			g_ksample4 = kernel_page(&k_sample4);
+			if (g_ksample4 == 0 || !vm_init(smmu)) {
+				printf("SWEET GPU: service bring-up FAILED\n");
+				return;
+			}
+			g_gpu = gpu;
+			g_scratch = scratch;
+			g_scratch_va = scratch_va;
+			g_ready = true;
+			printf("SWEET GPU: service ready (300 MHz, GPU VA window 8-16 GB)\n");
+			api_selftest();
+			int mhz = 300;
+			(void)PE_parse_boot_argn("sweetgpuclk", &mhz, sizeof(mhz));
+			g_max_mhz = 300;
+			uint64_t us300 = quad_bench();
+			if (mhz == 400 || mhz == 600) {
+				lck_mtx_lock(&sweet_gpu_vm_lock);
+				bool ok = gfx_raise(mhz);
+				lck_mtx_unlock(&sweet_gpu_vm_lock);
+				g_max_mhz = ok ? mhz : 300;
+				uint64_t usx = ok ? quad_bench() : 0;
+				printf("SWEET GPU: full-screen quad %llu us at 300 MHz, %llu us at %d MHz (%s)\n",
+				    us300, usx, mhz, !ok ? "switch FAILED" : mhz == 600 ? "S2 1015 mV, MX turbo, GPLL0/1" :
+				    "S2 825 mV, GPLL0/1.5");
+				if (ok) {
+					api_selftest();
+				}
+			} else {
+				printf("SWEET GPU: full-screen quad %llu us at 300 MHz\n", us300);
+			}
+			return;
+		}
+		if (level >= 7) {
+			(void)gfx_clock(3);     /* 300 MHz */
+			bool vm = vm_init(smmu);
+			printf("SWEET GPU: GPU VA window 8-16 GB %s\n", vm ? "ready" : "FAILED");
+			if (vm) {
+				sample_test(gpu, smmu, scratch_va, scratch, true);
+			}
+			return;
+		}
+		blit_test(gpu, smmu, scratch_va, scratch);
+		if (level >= 4) {
+			gpu_wait(2);
+			compute_test(gpu, smmu, scratch_va, scratch);
+		}
+		if (level >= 6) {
+			gpu_wait(2);
+			(void)gfx_clock(3);     /* 300 MHz */
+			sample_test(gpu, smmu, scratch_va, scratch, false);
+		} else if (level >= 5) {
+			gpu_wait(2);
+			bench_test(gpu, smmu, scratch_va, scratch);
+		}
+	}
+}
+
+#if defined(KUGO)
+static vm_offset_t spmi_core, spmi_obs_base, spmi_chnls_base;
+
+static uint32_t
+kugo_spmi_apid(uint16_t ppid)
+{
+	for (uint32_t apid = 0; apid < 256; apid++) {
+		uint32_t map = rd(spmi_core, 0x800u + 4u * apid);
+		if (map && ((map >> 8) & 0xfffu) == ppid) {
+			return apid;
+		}
+	}
+	return 0xffff;
+}
+
+/* PMIC arbiter v2, one byte: observer channel to read, this EE's channel to write (EXT_WRITEL). */
+static bool
+kugo_pmic_xfer(uint16_t ppid, uint8_t addr, uint8_t *val, bool write)
+{
+	if (spmi_core == 0) {
+		spmi_core = ml_io_map(SPMI_CORE_PA, 0x1000);
+		if (spmi_core == 0) {
+			return false;
+		}
+	}
+	uint32_t apid = kugo_spmi_apid(ppid);
+	if (apid == 0xffff) {
+		return false;
+	}
+	vm_offset_t ch = ml_io_map((write ? SPMI_CHNLS_PA : SPMI_OBS_PA) + 0x8000u * apid, 0x1000);
+	if (ch == 0) {
+		return false;
+	}
+	if (write) {
+		wr(ch, 0x10, *val);
+	}
+	wr(ch, 0x00, ((write ? 0u : 1u) << 27) | ((uint32_t)addr << 4));
+	for (int i = 0; i < 1000; i++) {
+		uint32_t st = rd(ch, 0x08);
+		if (st & 0x0eu) {
+			return false;
+		}
+		if (st & 1u) {
+			if (!write) {
+				*val = (uint8_t)rd(ch, 0x18);
+			}
+			return true;
+		}
+		delay(1);
+	}
+	return false;
+}
+
+static bool
+kugo_pmic_read(uint16_t ppid, uint8_t addr, uint8_t *out)
+{
+	return kugo_pmic_xfer(ppid, addr, out, false);
+}
+
+static bool
+kugo_pmic_write(uint16_t ppid, uint8_t addr, uint8_t val)
+{
+	return kugo_pmic_xfer(ppid, addr, &val, true);
+}
+
+static void
+kugo_dump(vm_offset_t g, const char *when)
+{
+	printf("SWEET GPU: %s cx %08x gx %08x clamp %08x rcg %08x/%08x gfx3d %08x gmem %08x ahb %08x "
+	    "timer %08x aon %08x bimc_gfx %08x\n", when, rd(g, G_CX_GDSC), rd(g, G_GX_GDSC), rd(g, G_GX_CLAMP),
+	    rd(g, G_GFX3D_CMD), rd(g, G_GFX3D_CFG), rd(g, G_GFX3D_BR), rd(g, G_GMEM_BR), rd(g, G_AHB_BR),
+	    rd(g, G_TIMER_BR), rd(g, G_AON_BR), rd(g, G_BIMC_GFX_BR));
+}
+
+/* the shim probe's sequence (shim/gpu.c), with the rail code of the Pixel path */
+static void
+gpu_thread(void *arg, wait_result_t result)
+{
+	(void)result;
+	g_level = (int)(uintptr_t)arg;
+	gpu_sleep(g_level >= 8 ? 2 : 20);
+	vm_offset_t g = ml_io_map(GCC_PA, 0x80000);
+	if (g == 0) {
+		printf("SWEET GPU: map failed\n");
+		return;
+	}
+	mmcc = g;
+	uint8_t s5[7] = {0};
+	static const uint8_t s5regs[7] = {0x04, 0x05, 0x08, 0x40, 0x41, 0x45, 0x46};
+	bool s5ok = true;
+	for (int i = 0; i < 7; i++) {
+		s5ok = s5ok && sweet_pmic_read(GFX_S2, s5regs[i], &s5[i]);
+	}
+	printf("SWEET GPU: A510, PM8004 S5 %s type %02x subtype %02x status %02x range %02x vset %02x mode %02x en %02x\n",
+	    s5ok ? "ok" : "UNREADABLE", s5[0], s5[1], s5[2], s5[3], s5[4], s5[5], s5[6]);
+	kugo_dump(g, "at boot:");
+	if (!s5ok || s5[3] != 0) {
+		printf("SWEET GPU: S5 unreadable or not range 0, stop\n");
+		return;
+	}
+	uint8_t vset = (uint8_t)((KUGO_GFX_MV - 80) / 5), en = 0, v = 0, st = 0;
+	bool ok = sweet_pmic_write(GFX_S2, 0x41, vset) && sweet_pmic_write(GFX_S2, 0x46, 0x80);
+	delay(2000);
+	(void)(sweet_pmic_read(GFX_S2, 0x46, &en) && sweet_pmic_read(GFX_S2, 0x41, &v) &&
+	    sweet_pmic_read(GFX_S2, 0x08, &st));
+	printf("SWEET GPU: S5 %u mV %s: en %02x vset %02x status %02x\n", KUGO_GFX_MV,
+	    ok && (en & 0x80) ? "on" : "FAILED", en, v, st);
+	if (!ok || !(en & 0x80)) {
+		return;
+	}
+
+	bool ahb = branch_on(g, G_AHB_BR), bimc = branch_on(g, G_BIMC_GFX_BR);
+	(void)branch_on(g, G_AON_BR);
+	(void)branch_on(g, G_TIMER_BR);
+	wr(g, G_CX_GDSC, rd(g, G_CX_GDSC) & ~1u);
+	bool cx = poll(g, G_CX_GDSC, 1u << 31, 1u << 31, 100);
+	(void)gfx_clock(7);                     /* GPLL0 / 4 = 200 MHz */
+	wr(g, G_GX_GDSC, rd(g, G_GX_GDSC) & ~1u);
+	(void)poll(g, G_GX_GDSC, 1u << 31, 1u << 31, 100);
+	wr(g, G_GX_CLAMP, rd(g, G_GX_CLAMP) & ~1u);
+	bool b1 = branch_on(g, G_GFX3D_BR), b2 = branch_on(g, G_GMEM_BR);
+	kugo_dump(g, "after power-up:");
+	printf("SWEET GPU: cx %s ahb %s bimc_gfx %s gfx3d %s gmem %s\n", cx ? "on" : "TIMEOUT",
+	    ahb ? "on" : "OFF", bimc ? "on" : "OFF", b1 ? "on" : "OFF", b2 ? "on" : "OFF");
+	if (!(cx && ahb && b1)) {
+		printf("SWEET GPU: not all on, no GPU register access\n");
+		return;
+	}
+	vm_offset_t gpu = ml_io_map(GPU_PA, 0x40000);
+	if (gpu == 0) {
+		printf("SWEET GPU: GPU map failed\n");
+		return;
+	}
+	uint32_t vbif = rd(gpu, 0x3000 * 4), status = rd(gpu, 0x4f5 * 4), aon0 = rd(gpu, 0x4d2 * 4);
+	delay(1000);
+	uint32_t aon1 = rd(gpu, 0x4d2 * 4);
+	printf("SWEET GPU: VBIF_VERSION %08x RBBM_STATUS %08x ALWAYSON %08x -> %08x (%s)\n",
+	    vbif, status, aon0, aon1, aon1 != aon0 ? "counting: GPU alive" : "not counting");
+	if (g_level >= 2 && aon1 != aon0) {
+		gpu_wait(2);
+		cp_test(gpu, g_level);
+	}
+}
+#else
+
+static void
+gpu_thread(void *arg, wait_result_t result)
+{
+	(void)result;
+	g_level = (int)(uintptr_t)arg;
+	if (g_level >= 8) {
+		/* as soon as the PMIC answers (sweet_keys maps SPMI during boot) */
+		uint8_t t;
+		for (int i = 0; i < 60 && !sweet_pmic_read(GFX_S2, 0x04, &t); i++) {
+			gpu_sleep(1);
+		}
+	} else {
+		gpu_sleep(40);
+	}
+	vm_offset_t mm = ml_io_map(MMCC_PA, 0x10000);
+	vm_offset_t gcc = ml_io_map(GCC_PA + 0x9000, 0x1000);
+	vm_offset_t gcc46 = ml_io_map(GCC_PA + 0x46000, 0x1000);
+	vm_offset_t memacc = ml_io_map(MEMACC_PA, 0x1000);
+	mmcc = mm;
+	if (mm == 0 || gcc == 0 || gcc46 == 0 || memacc == 0) {
+		printf("SWEET GPU: map failed\n");
+		return;
+	}
+
+	/* 1. Read-only state. */
+	uint8_t s2[7] = {0};
+	static const uint8_t s2regs[7] = {0x04, 0x05, 0x08, 0x40, 0x41, 0x45, 0x46};
+	bool s2ok = false;
+	/* the first answers can be partial (0160d: type 00): read again a few times */
+	for (int attempt = 0; attempt < 10 && !(s2ok && s2[0] == 0x1c); attempt++) {
+		if (attempt > 0) {
+			gpu_sleep(1);
+		}
+		s2ok = true;
+		for (int i = 0; i < 7; i++) {
+			s2ok = s2ok && sweet_pmic_read(GFX_S2, s2regs[i], &s2[i]);
+		}
+	}
+	printf("SWEET GPU: S2 %s type %02x subtype %02x status %02x range %02x vset %02x (%u) mode %02x en %02x; mem-acc %08x\n",
+	    s2ok ? "ok" : "UNREADABLE", s2[0], s2[1], s2[2], s2[3], s2[4], s2[4], s2[5], s2[6],
+	    rd(memacc, 4));
+	dump(mm, gcc, gcc46, "at boot:");
+	gpu_wait(11);
+
+	/* 2. GFX rail. Range 0 only: FTS2 (subtype 8) 5 mV steps from 0, FTS2.5 (9) from 80 mV. */
+	if (!s2ok || s2[0] != 0x1c || s2[3] != 0 || (s2[1] != 8 && s2[1] != 9)) {
+		printf("SWEET GPU: S2 not a range-0 FTS2/2.5 regulator, stop\n");
+		return;
+	}
+	if (!(s2[6] & 0x80)) {
+		uint8_t vset = (uint8_t)((745 - (s2[1] == 9 ? 80 : 0)) / 5);
+		bool ok = false;
+		uint8_t en = 0, v = 0, st = 0;
+		/* the enable did not stick once (0154b: en 00, GPU never came up): retry */
+		for (int attempt = 0; attempt < 5 && !(ok && (en & 0x80)); attempt++) {
+			ok = sweet_pmic_write(GFX_S2, 0x41, vset) && sweet_pmic_write(GFX_S2, 0x46, 0x80);
+			delay(1000 + attempt * 10000);
+			(void)(sweet_pmic_read(GFX_S2, 0x46, &en) && sweet_pmic_read(GFX_S2, 0x41, &v) &&
+			    sweet_pmic_read(GFX_S2, 0x08, &st));
+			printf("SWEET GPU: S2 enable %s (try %d): en %02x vset %u status %02x\n",
+			    ok && (en & 0x80) ? "ok" : "FAILED", attempt + 1, en, v, st);
+		}
+		if (!ok || !(en & 0x80)) {
+			return;
+		}
+	} else {
+		printf("SWEET GPU: S2 already on (vset %u), left as is\n", s2[4]);
+	}
+	gpu_wait(11);
+
+	/* 3. CX side: GPU GDSC + AHB clock. */
+	bool cx = gdsc_on(mm, 0x4034);
+	bool ahb = branch_on(mm, 0x403c);
+	printf("SWEET GPU: gpu_gdsc %s %08x, ahb %s %08x\n", cx ? "on" : "TIMEOUT", rd(mm, 0x4034),
+	    ahb ? "on" : "TIMEOUT", rd(mm, 0x403c));
+	gpu_wait(11);
+
+	/* 4. GX: release IO clamp, GDSC on, retain mem/periph on the core branch. */
+	wr(mm, 0x4300, rd(mm, 0x4300) & ~1u);
+	bool gx = gdsc_on(mm, 0x4024);
+	wr(mm, 0x4028, rd(mm, 0x4028) | (1u << 14) | (1u << 13));
+	printf("SWEET GPU: gx_gdsc %s %08x clamp %08x\n", gx ? "on" : "TIMEOUT", rd(mm, 0x4024), rd(mm, 0x4300));
+	gpu_wait(11);
+
+	/* 5. Clocks: gfx3d = GPLL0 (src 5) / 3 (div field 2*3-1), rbbmtimer = XO. */
+	wr(mm, 0x4004, (5u << 8) | 5u);
+	wr(mm, 0x4000, rd(mm, 0x4000) | 1u);
+	bool r1 = poll(mm, 0x4000, 1u, 0, 10);
+	wr(mm, 0x4094, (0u << 8) | 0u);
+	wr(mm, 0x4090, rd(mm, 0x4090) | 1u);
+	bool r2 = poll(mm, 0x4090, 1u, 0, 10);
+	bool b1 = branch_on(mm, 0x4028), b2 = branch_on(mm, 0x40b0);
+	bool g1 = branch_on(gcc, 0x10), g2 = branch_on(gcc46, 0x18);
+	printf("SWEET GPU: rcg gfx3d %s rbbm %s; branches gfx3d %s rbbm %s mmss_bimc_gfx %s bimc_gfx %s\n",
+	    r1 ? "ok" : "TIMEOUT", r2 ? "ok" : "TIMEOUT", b1 ? "on" : "OFF", b2 ? "on" : "OFF",
+	    g1 ? "on" : "OFF", g2 ? "on" : "OFF");
+	dump(mm, gcc, gcc46, "after power-up:");
+	if (!(cx && ahb && gx && b1 && b2 && g1 && g2)) {
+		printf("SWEET GPU: not all on, no GPU register access\n");
+		return;
+	}
+	gpu_wait(11);
+
+	/* 6. GPU registers. */
+	vm_offset_t gpu = ml_io_map(GPU_PA, 0x40000);
+	if (gpu == 0) {
+		printf("SWEET GPU: GPU map failed\n");
+		return;
+	}
+	printf("SWEET GPU: reading GPU registers\n");
+	uint32_t vbif = rd(gpu, 0x3000 * 4);
+	uint32_t status = rd(gpu, 0x4f5 * 4);
+	uint32_t aon0 = rd(gpu, 0x4d2 * 4);
+	delay(1000);
+	uint32_t aon1 = rd(gpu, 0x4d2 * 4);
+	printf("SWEET GPU: VBIF_VERSION %08x RBBM_STATUS %08x ALWAYSON %08x -> %08x (%s)\n",
+	    vbif, status, aon0, aon1, aon1 != aon0 ? "counting: GPU alive" : "not counting");
+	if ((int)(uintptr_t)arg >= 2 && aon1 != aon0) {
+		gpu_wait(11);
+		cp_test(gpu, (int)(uintptr_t)arg);
+	}
+}
+#endif /* !KUGO: the Pixel's gpu_thread */
+
+void
+sweet_gpu_init(void)
+{
+	int on = 0;
+	thread_t thread;
+	if (!PE_parse_boot_argn("sweetgpu", &on, sizeof(on)) || on == 0) {
+		return;
+	}
+	if (kernel_thread_start(gpu_thread, (void *)(uintptr_t)on, &thread) == KERN_SUCCESS) {
+		thread_deallocate(thread);
+	}
+}
+#endif /* ARM64_BOARD_CONFIG_SWEET || KUGO */
diff --git a/bsd/dev/sweet_gpu.h b/bsd/dev/sweet_gpu.h
new file mode 100644
index 0000000..74eeae6
--- /dev/null
+++ b/bsd/dev/sweet_gpu.h
@@ -0,0 +1,109 @@
+/*
+ * Adreno 530 kernel API (bsd/dev/sweet_gpu.c), used by the SweetGPU user
+ * client (iokit/Kernel/arm/SweetGPU.cpp). The struct is also the user
+ * client's quad argument, so its layout is ABI.
+ */
+#ifndef _SWEET_GPU_H
+#define _SWEET_GPU_H
+
+#include <sys/cdefs.h>
+#include <stdint.h>
+#include <stdbool.h>
+
+__BEGIN_DECLS
+
+/*
+ * Textured quad: for each pixel (X, Y) of the dst rect (x0, y0, w, h) on
+ * the inner side of the nedges edges (a (X+.5) + b (Y+.5) + c >= 0),
+ * (u, v) = (m[0] m[2]; m[1] m[3]) (X + .5, Y + .5) + (m[4], m[5]) in src
+ * texels (unnormalized), s = bilinear (flags bit 0: nearest) sample of src,
+ * clamped to its edge, channels picked by src_swiz, times color (per
+ * channel); dst = s + dst * (1 - s.a) (source-over; flags SWEET_GPU_QUAD_ADD:
+ * min(s + dst, 1), SWEET_GPU_QUAD_COPY: s). dst is 4 bytes per pixel,
+ * premultiplied, alpha in byte 3 (BGRA8 or RGBA8); src is src_fmt. Images at
+ * GPU VAs from sweet_gpu_vm_map (64-byte aligned); pitches in bytes, multiples
+ * of 64 (the texture unit rounds a pitch up to 64: with any other pitch it
+ * reads past the image, faults and hangs, 0140a). dst must be in a writable
+ * mapping.
+ */
+struct sweet_gpu_quad {
+	uint64_t src_va, dst_va;
+	uint32_t src_w, src_h, src_pitch;
+	uint32_t dst_w, dst_h, dst_pitch;
+	uint32_t x0, y0, w, h;
+	uint32_t m[6];          /* float bits: a, b, c, d, tx, ty */
+	uint32_t reserved;      /* 0 (was opacity: use color) */
+	uint32_t flags;
+	uint32_t color[4];      /* float bits, per channel in memory order */
+	uint32_t src_fmt;       /* SWEET_GPU_FMT_* */
+	uint32_t src_swiz;      /* 4 x 3 bits, channel x first: 0-3 texel x y z w, 4 = 0, 5 = 1 (0x688 = xyzw) */
+	uint32_t nedges;        /* 0-4 */
+	uint32_t edge[4][3];    /* float bits a, b, c */
+};
+
+#define SWEET_GPU_FMT_RGBA8     0u      /* 4 bytes per pixel */
+#define SWEET_GPU_FMT_R8        1u      /* 1 byte */
+#define SWEET_GPU_FMT_RG8       2u      /* 2 bytes */
+
+#define SWEET_GPU_QUAD_NEAREST  1u
+#define SWEET_GPU_QUAD_ADD      2u
+#define SWEET_GPU_QUAD_COPY     4u
+
+/* True once the GPU is up (sweetgpu=8) and accepts work. */
+bool sweet_gpu_ready(void);
+
+/*
+ * Map npages pages (PAGE_SIZE each) at a new GPU VA; 0 on failure. A
+ * read-only mapping can only be a quad source (SMMU entries read-only).
+ */
+uint64_t sweet_gpu_vm_map(const uint64_t *pa, uint32_t npages, bool readonly);
+
+/* Unmap a VA returned by sweet_gpu_vm_map. */
+void sweet_gpu_vm_unmap(uint64_t va);
+
+/*
+ * Run one quad and wait for it; 0 on success, else an errno value. After a
+ * timeout (GPU hung) the service is off until reboot: ENXIO from then on.
+ */
+int sweet_gpu_quad(const struct sweet_gpu_quad *q);
+
+/*
+ * Command submission for user-space drivers (Mesa freedreno through the
+ * SweetGPU user client). Each IB is a CP_INDIRECT_BUFFER_PFE of dwords
+ * dwords at a GPU VA inside a mapping; after them the ring writes the
+ * submit's sequence number to the fence page (CACHE_FLUSH_TS). Returns 0
+ * and the sequence number, ENXIO (GPU off), EINVAL, EFAULT (IB outside the
+ * mapped window) or ETIMEDOUT (ring full for 500 ms: hung, service off).
+ */
+struct sweet_gpu_ib {
+	uint64_t iova;
+	uint32_t dwords;
+	uint32_t pad;
+};
+#define SWEET_GPU_MAX_IBS       256u
+
+int sweet_gpu_submit(const struct sweet_gpu_ib *ib, uint32_t n, uint32_t *seqno);
+
+/*
+ * Wait until submit seqno has completed: 0, ETIMEDOUT after timeout_ms, or
+ * ENXIO (GPU off; also when the fence has not moved for 2 s with work
+ * outstanding: the GPU is declared hung and the service goes off).
+ */
+int sweet_gpu_wait(uint32_t seqno, uint32_t timeout_ms);
+
+struct sweet_gpu_info {
+	uint32_t chip_id;               /* core << 24 | major << 16 | minor << 8 | patch */
+	uint32_t gmem_size;
+	uint64_t gmem_base;
+	uint64_t max_freq;              /* Hz */
+	uint64_t fence_pa;              /* page: u32 last completed seqno at +0 */
+};
+
+void sweet_gpu_get_info(struct sweet_gpu_info *info);
+
+/* The fence page (SweetGPU allocates it so that it can map it into clients). */
+void sweet_gpu_set_fence_page(uintptr_t kva, uint64_t pa);
+
+__END_DECLS
+
+#endif /* _SWEET_GPU_H */
diff --git a/bsd/dev/sweet_gpu_shaders.h b/bsd/dev/sweet_gpu_shaders.h
new file mode 100644
index 0000000..a01b8cd
--- /dev/null
+++ b/bsd/dev/sweet_gpu_shaders.h
@@ -0,0 +1,153 @@
+/*
+ * Adreno 530 compute kernels for sweet_gpu.c, generated by tools/ir3asm
+ * (tools/build-ir3asm.sh) from tools/gpu-shaders/*.asm. Do not edit.
+ */
+/* k_fill: generated by tools/ir3asm from tools/gpu-shaders/fill.asm */
+static const uint32_t k_fill_bin[32] = {
