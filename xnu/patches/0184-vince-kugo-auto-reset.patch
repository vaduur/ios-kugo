diff --git a/bsd/dev/vince_ctl.c b/bsd/dev/vince_ctl.c
index f19da02..eaa9d72 100644
--- a/bsd/dev/vince_ctl.c
+++ b/bsd/dev/vince_ctl.c
@@ -75,4 +75,66 @@ vince_ctl_start(void)
 		printf("VINCE CTL: thread not started\n");
 	}
 }
+
+#if defined(KUGO)
+#include <pexpert/pexpert.h>
+
+void kugo_reset_now(const char *why);
+void kugo_reset_start(void);
+
+static int kugo_reset_chan;
+
+/* Restart reason "normal", then a watchdog bite one 32 kHz tick out, interrupts off so we never reach WFI. */
+void
+kugo_reset_now(const char *why)
+{
+	vm_offset_t imem = ml_io_map(KUGO_IMEM_PHYS, 0x1000), wdt = ml_io_map(KUGO_WDT_PHYS, 0x1000);
+	printf("KUGO: %s, back to Android\n", why);
+	if (!imem || !wdt) {
+		printf("KUGO: reset mapping failed\n");
+		return;
+	}
+	(void)ml_set_interrupts_enabled(FALSE);
+	*(volatile uint32_t *)(imem + KUGO_IMEM_RESTART_REASON) = KUGO_RESTART_NORMAL;
+	*(volatile uint32_t *)(wdt + 0x08) = 0;       /* EN */
+	*(volatile uint32_t *)(wdt + 0x10) = 1;       /* BARK */
+	*(volatile uint32_t *)(wdt + 0x14) = 1;       /* BITE */
+	*(volatile uint32_t *)(wdt + 0x04) = 1;       /* RST */
+	*(volatile uint32_t *)(wdt + 0x08) = 1;       /* EN */
+	__asm__ volatile ("dsb sy" ::: "memory");
+	for (;;) {
+	}
+}
+
+static void
+kugo_reset_thread(void *arg, wait_result_t result)
+{
+	(void)result;
+	uint64_t deadline;
+	clock_interval_to_deadline((uint32_t)(uintptr_t)arg, NSEC_PER_SEC, &deadline);
+	(void)assert_wait_deadline(&kugo_reset_chan, THREAD_UNINT, deadline);
+	thread_block(THREAD_CONTINUE_NULL);
+	kugo_reset_now("kugoreset timer expired");
+}
+
+/* Unattended test boots: return to Android after kugoreset= seconds (default KUGO_RESET_DEFAULT_SECS). */
+void
+kugo_reset_start(void)
+{
+	uint32_t secs = KUGO_RESET_DEFAULT_SECS;
+	thread_t thread;
+
+	PE_parse_boot_argn("kugoreset", &secs, sizeof(secs));
+	if (secs == 0) {
+		printf("KUGO: auto reset off (kugoreset=0)\n");
+		return;
+	}
+	if (kernel_thread_start(kugo_reset_thread, (void *)(uintptr_t)secs, &thread) == KERN_SUCCESS) {
+		thread_deallocate(thread);
+		printf("KUGO: back to Android in %u s (kugoreset=)\n", secs);
+	} else {
+		printf("KUGO: auto reset thread not started\n");
+	}
+}
+#endif /* KUGO */
 #endif /* ARM64_BOARD_CONFIG_VINCE */
