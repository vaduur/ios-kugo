diff --git a/pexpert/pexpert/arm64/VINCE.h b/pexpert/pexpert/arm64/VINCE.h
index 289a45d..e010a8e 100644
--- a/pexpert/pexpert/arm64/VINCE.h
+++ b/pexpert/pexpert/arm64/VINCE.h
@@ -82,4 +82,15 @@
 #define KUGO_PSTORE_SIZE          0x20000
 #define KUGO_PSTORE_SIG           0x43474244
 
+/*
+ * Back to Android: restart reason "normal" in IMEM (LK reads it on a warm reset), then an APSS watchdog bite.
+ * The watchdog does not count while the CPUs sit in WFI, so an idle kernel never trips the 31 s one the shim
+ * arms; kugo_reset_start() (boot-arg kugoreset=SECONDS, 0 = off) bites on purpose instead.
+ */
+#define KUGO_IMEM_PHYS            0x08600000
+#define KUGO_IMEM_RESTART_REASON  0x65c
+#define KUGO_RESTART_NORMAL       0x77665501
+#define KUGO_WDT_PHYS             0x0b017000
+#define KUGO_RESET_DEFAULT_SECS   90
+
 #endif /* ! _PEXPERT_ARM64_VINCE_H */
