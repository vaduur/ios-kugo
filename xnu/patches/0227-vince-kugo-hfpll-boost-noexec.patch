+/*
+ * sweetnoexec=NAME,NAME,...: refuse to exec binaries with these file names (EPERM). Daemons for hardware
+ * this phone lacks spin otherwise: kugo's visual voicemail daemon vmd took 90% of a CPU without a modem.
+ * launchd sees the job fail and throttles its respawns. The first 8 refusals are logged.
+ */
+static char sweet_noexec[256];
+static int sweet_noexec_logged;
+
+static int
+sweet_amfi_vnode_check_exec(__unused kauth_cred_t cred, struct vnode *vp, __unused struct vnode *scriptvp,
+    __unused struct label *vnodelabel, __unused struct label *scriptlabel, __unused struct label *execlabel,
+    __unused struct componentname *cnp, __unused u_int *csflags, __unused void *macpolicyattr,
+    __unused size_t macpolicyattrlen)
+{
+	if (sweet_noexec[0] == '\0') {
+		return 0;
+	}
+	const char *name = vnode_getname(vp);
+	int error = 0;
+	if (name != NULL) {
+		size_t len = strlen(name);
+		for (const char *s = sweet_noexec; *s != '\0' && error == 0;) {
+			const char *e = strchr(s, ',');
+			size_t n = e != NULL ? (size_t)(e - s) : strlen(s);
+			if (n == len && strncmp(s, name, n) == 0) {
+				error = EPERM;
+			}
+			s += n + (e != NULL);
+		}
+		if (error && sweet_noexec_logged++ < 8) {
+			printf("SWEET AMFI: exec of %s refused (sweetnoexec)\n", name);
+		}
+		vnode_putname(name);
+	}
+	return error;
+}
+
 static const struct mac_policy_ops sweet_amfi_mac_ops = {
 	.mpo_vnode_check_signature = sweet_amfi_vnode_check_signature,
+	.mpo_vnode_check_exec = sweet_amfi_vnode_check_exec,
 	.mpo_policy_syscall = sweet_amfi_syscall,
 };
 
