+		bool mxok = true;
+		for (int i = 0; i < 4; i++) {
+			mxok = mxok && sweet_pmic_read(0x023, mxregs[i], &mx[i]);
+		}
+		printf("SWEET GPU: VDD_MX PM8950 S6 %s type %02x subtype %02x range %02x vset %02x\n",
+		    mxok ? "ok" : "UNREADABLE", mx[0], mx[1], mx[2], mx[3]);
+	}
 	if (!s5ok || s5[3] != 0) {
 		printf("SWEET GPU: S5 unreadable or not range 0, stop\n");
