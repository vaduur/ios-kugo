diff --git a/osfmk/arm64/sweet_early.c b/osfmk/arm64/sweet_early.c
index ab2e019..fb5cfab 100644
--- a/osfmk/arm64/sweet_early.c
+++ b/osfmk/arm64/sweet_early.c
@@ -9,6 +9,9 @@
 
 #if defined(KUGO)
 #include <arm64/proc_reg.h>
+#include <stdbool.h>
+#include <machine/atomic.h>
+#include <machine/machine_routines.h>
 #define EARLY_FB_PHYS ((uint64_t)KUGO_FB_PHYS)
 #define EARLY_WIDTH ((unsigned int)KUGO_FB_WIDTH)
 #define EARLY_HEIGHT ((unsigned int)KUGO_FB_HEIGHT)
@@ -55,9 +58,33 @@ static volatile uint8_t *early_plog = (volatile uint8_t *)(uintptr_t)KUGO_PSTORE
  * Append to the console mirror. The record is a ring, as ramoops reads every zone (header: signature,
  * start = next write, size = valid bytes; Android unwraps it in order), so the latest output survives.
  */
+/*
+ * Once secondary CPUs run (SweetCPU calls kugo_plog_smp_on before the first PSCI CPU_ON) several cores
+ * write here at once; a torn header (start > size) makes ramoops drop the whole record. From then on the
+ * update is under a spinlock, interrupts off, bounded so a panic still gets through. Not before: the
+ * early writes happen with the MMU off, where exclusives on Device memory do not work.
+ */
+static uint32_t kugo_plog_lock;
+static bool kugo_plog_smp;
+
+void
+kugo_plog_smp_on(void)
+{
+	__asm__ volatile("dmb ish" ::: "memory");
+	kugo_plog_smp = true;
+}
+
 void
 kugo_plog_putc(char c)
 {
+	boolean_t istate = FALSE;
+	bool held = false, smp = kugo_plog_smp;
+	if (smp) {
+		istate = ml_set_interrupts_enabled(FALSE);
+		for (unsigned int i = 0; i < 10000000u && !held; i++) {
+			held = os_atomic_cmpxchg(&kugo_plog_lock, 0, 1, acquire);
+		}
+	}
 	const uint32_t cap = KUGO_PSTORE_SIZE - 12;
 	volatile uint32_t *hdr = (volatile uint32_t *)early_plog;
 	if (hdr[0] != KUGO_PSTORE_SIG) {
@@ -75,6 +102,12 @@ kugo_plog_putc(char c)
 	if (c == '\n') {
 		__asm__ volatile("dsb sy" ::: "memory");
 	}
+	if (smp) {
+		if (held) {
+			os_atomic_store(&kugo_plog_lock, 0, release);
+		}
+		ml_set_interrupts_enabled(istate);
+	}
 }
 #endif
 
