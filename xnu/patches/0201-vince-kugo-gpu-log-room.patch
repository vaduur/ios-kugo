diff --git a/bsd/dev/sweet_gpu.c b/bsd/dev/sweet_gpu.c
index dd1448f..e81d907 100644
--- a/bsd/dev/sweet_gpu.c
+++ b/bsd/dev/sweet_gpu.c
@@ -286,6 +286,10 @@ static int g_level;     /* the sweetgpu boot-arg */
 static void
 gpu_wait(unsigned secs)
 {
+#if defined(KUGO)
+	/* the Pixel paused 11 s per step for its 10 s UFS log flush; kugo's pstore mirror is immediate */
+	secs = secs > 1 ? 1 : secs;
+#endif
 	if (g_level >= 8 && secs > 2) {
 		return;
 	}
@@ -2300,7 +2304,7 @@ gpu_thread(void *arg, wait_result_t result)
 {
 	(void)result;
 	g_level = (int)(uintptr_t)arg;
-	gpu_sleep(g_level >= 8 ? 2 : 20);
+	gpu_sleep(2);
 	vm_offset_t g = ml_io_map(GCC_PA, 0x80000);
 	if (g == 0) {
 		printf("SWEET GPU: map failed\n");
diff --git a/osfmk/arm64/sweet_early.c b/osfmk/arm64/sweet_early.c
index 2ee1123..3088d2c 100644
--- a/osfmk/arm64/sweet_early.c
+++ b/osfmk/arm64/sweet_early.c
@@ -61,7 +61,7 @@ static volatile uint8_t *early_plog = (volatile uint8_t *)(uintptr_t)KUGO_PSTORE
  * (header, shim, early boot) are kept; past the end the writes wrap to KUGO_PLOG_KEEP, and a NUL after
  * the last character marks the cursor (tools/plog_unwrap.py puts the pieces back in order).
  */
-#define KUGO_PLOG_KEEP 0x8000u
+#define KUGO_PLOG_KEEP 0x14000u
 static uint32_t kugo_plog_pos;
 static bool kugo_plog_started;
 
