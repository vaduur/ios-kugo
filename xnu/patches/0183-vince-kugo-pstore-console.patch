diff --git a/osfmk/arm64/sweet_early.c b/osfmk/arm64/sweet_early.c
index c1c95bf..f130490 100644
--- a/osfmk/arm64/sweet_early.c
+++ b/osfmk/arm64/sweet_early.c
@@ -47,6 +47,31 @@ kugo_early_kick(void)
 	for (unsigned int i = 0; i < 0x100000u && !(*status & (1u << KUGO_PP0_DONE_BIT)); i++) {
 	}
 }
+
+/* pstore record (VINCE.h): PA (MMU off) / V=P L1[1] block (start.s), then the KVA block after the MDSS one. */
+static volatile uint8_t *early_plog = (volatile uint8_t *)(uintptr_t)KUGO_PSTORE_PHYS;
+
+/* Append to the console mirror; once the record is full, later output is dropped (the start matters most). */
+void
+kugo_plog_putc(char c)
+{
+	volatile uint32_t *hdr = (volatile uint32_t *)early_plog;
+	if (hdr[0] != KUGO_PSTORE_SIG) {
+		hdr[1] = 0;
+		hdr[2] = 0;
+		hdr[0] = KUGO_PSTORE_SIG;
+	}
+	uint32_t pos = hdr[2];
+	if (pos >= KUGO_PSTORE_SIZE - 12) {
+		return;
+	}
+	early_plog[12 + pos] = (uint8_t)c;
+	hdr[1] = pos + 1;
+	hdr[2] = pos + 1;
+	if (c == '\n') {
+		__asm__ volatile("dsb sy" ::: "memory");
+	}
+}
 #endif
 
