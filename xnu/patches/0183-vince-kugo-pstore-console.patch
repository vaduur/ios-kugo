 #define KUGO_CTL_PAGE_PHYS        0x8fff0000
 
+/*
+ * Kernel console mirror: ramoops dump record 0 (live DT ramoops@57f00000, record 128 KiB, no ECC,
+ * "DBGC" header). The shim's log is already there; kernel output is appended, and after the watchdog
+ * reset Android shows both as /sys/fs/pstore/dmesg-ramoops-0.
+ */
+#define KUGO_PSTORE_PHYS          0x57f00000
+#define KUGO_PSTORE_SIZE          0x20000
+#define KUGO_PSTORE_SIG           0x43474244
+
