+	early_plog = (volatile uint8_t *)(uintptr_t)(base + (uint64_t)(KUGO_FB_BLOCKS + 1) * ARM_TT_L2_SIZE +
+	    (KUGO_PSTORE_PHYS & (ARM_TT_L2_SIZE - 1)));
 #elif defined(VINCE)
 	early_fb = (volatile uint8_t *)(uintptr_t)(base + 0x1000);
 #else
