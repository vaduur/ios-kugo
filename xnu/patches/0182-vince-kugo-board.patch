+	 * KUGO: KUGO_FB_BLOCKS blocks at KUGO_FB_PHYS, in the same 1 GiB as the kernel (0x80000000..), so this
+	 * L2 table holds them too.
 	 */
+#if defined(KUGO)
+	MOV64	x10, KUGO_FB_PHYS
+#else
 	MOV64	x10, 0x90000000
+#endif
 	MOV64	x14, (ARM_TTE_TYPE_BLOCK | ARM_TTE_VALID | ARM_TTE_BLOCK_SH(SH_OUTER_MEMORY) | ARM_TTE_BLOCK_ATTRINDX(CACHE_ATTRINDX_WRITECOMB) | ARM_TTE_BLOCK_AF | ARM_TTE_BLOCK_PNX | ARM_TTE_BLOCK_NX)
