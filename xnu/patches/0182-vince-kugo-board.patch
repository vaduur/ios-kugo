diff --git a/pexpert/pexpert/arm64/VINCE.h b/pexpert/pexpert/arm64/VINCE.h
index e008bb3..4e616d4 100644
--- a/pexpert/pexpert/arm64/VINCE.h
+++ b/pexpert/pexpert/arm64/VINCE.h
@@ -43,4 +43,34 @@
 #define MSM8953_GICD_BASE         0x0b000000ULL
 #define MSM8953_GICC_BASE         0x0b002000ULL
 
+/*
+ * iSony fork: this vince kernel runs on the Sony Xperia X Compact ("kugo", MSM8956: 4x Cortex-A53 +
+ * 2x Cortex-A72, GICv2 at the same addresses). Everything vince applies; KUGO marks what differs.
+ * No ULL suffixes: start.s uses these too.
+ */
+#define KUGO                      1
+
+/* LK's splash buffer when it boots the recovery slot: 720x1280, 24 bpp (bytes B, G, R), stride 2160. */
+#define KUGO_FB_PHYS              0x83200000
+#define KUGO_FB_WIDTH             720
+#define KUGO_FB_HEIGHT            1280
+#define KUGO_FB_STRIDE            2160
+#define KUGO_FB_BLOCKS            2               // 2 MiB L2 blocks covering it
+
+/*
+ * Command-mode DSI panel: nothing reaches the screen until MDP CTL0 START sends a frame. Kick after
+ * drawing; wait for PING_PONG_0_DONE so a START never lands mid-transfer (that desyncs the panel).
+ */
+#define KUGO_MDSS_PHYS            0x01a00000
+#define KUGO_MDP_INTR_STATUS      0x1014
+#define KUGO_MDP_INTR_CLEAR       0x1018
+#define KUGO_PP0_DONE_BIT         8
+#define KUGO_CTL0_START           0x201c
+
+/*
+ * vince's shim-visible page (SMP marks, halt word) sits at PA 0x913F0000, outside vince's XNU RAM
+ * (0xa0000000+) but inside ours (0x90000000..0xd3c00000). Use the last page below our RAM instead.
+ */
+#define KUGO_CTL_PAGE_PHYS        0x8fff0000
+
 #endif /* ! _PEXPERT_ARM64_VINCE_H */
