+
+/*
+ * Row bytes for an explicit value (0: none). Explicit rows are rounded up to the alignment too: the
+ * Adreno 5xx texture and render target pitch needs 64-byte rows, and CA takes the real value from the
+ * lock result (SpringBoard asks for 833 px in 3360 bytes, renders into it on the GPU). Bare geometry
+ * requests (6 keys or fewer) get them as asked: CoreUI fills its glyph surfaces with the row bytes it
+ * asked for (sweetgl copies those). (ios-sailfish 0153, 0160, 0162)
+ */
+static uint32_t
+sweet_rows(uint32_t asked, uint32_t width, uint32_t ew, uint32_t bpe, unsigned int keys)
+{
+	if (asked == 0) {
+		return sweet_row_bytes(width, ew, bpe);
+	}
+	return keys <= 6 ? asked : sweet_row_align(asked);
+}
